# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Build output under a NEXT_DIST_DIR chosen to leave the dev server alone.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip
!module-marketplace/*.zip
!theme-marketplace/*.zip
*.tar.gz
*.rar
# Backup dump files written to the repo root (e.g. blysis-scheduled-*.sql.gz).
# Keep this ANCHORED to the root so it doesn't accidentally swallow
# src/core/lib/backup.ts and similar first-party source files.
/backup*.sql.gz
/backup*.tar.gz
/backup*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Local `next start` / dev-server logs. Dotfiles are not ignored by default,
# so `git add -A` will otherwise commit them.
.*.log
*.log

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
src/generated/

# Prisma schema is auto-merged by scripts/merge-schemas.ts from schema.core.prisma
# + module sources at predev/prebuild/postinstall time. Never commit the merged output.
prisma/schema.prisma

# Core generated files (module registry, route map, theme registry, openapi, etc.)
# Regenerated by scripts/generate-registry.ts / generate-themes.ts at every build.
src/core/generated/

# md files (block analysis/internal, keep README and docs)
CLAUDE.md
COMPETITOR_ANALYSIS.md
QUALITY_ANALYSIS.md
ROADMAP.md
!README.md
!docs/*.md

# Internal AI-assisted planning/spec artifacts - not part of the public release.
docs/superpowers/

# claude code
.claude/

# Internal documentation lives in a separate private repository.
# `next dev` rewrites AGENTS.md on every boot, so it is ignored rather
# than committed.
docs/
CHANGELOG.md
AGENTS.md

# Test artifacts
*.png
!public/**/*.png
# Next reads app icons out of the file tree, so these are source, not output.
!src/app/apple-icon.png
!src/app/icon.png
.playwright-mcp/
test-results/
playwright-report/

backups/
*.sql
*.sql.gz
# ...but per-module SQL migrations are source, not a dump: they ship inside the
# module ZIP and are replayed by scripts/apply-migrations.ts.
!module-sources/*/migrations/*.sql
!module-template/migrations/*.sql
# Core's own are the same kind of thing: the only way a core table changes
# shape on a database that already has data, replayed by the same runner.
!prisma/migrations/*.sql
.env.production
.env.staging
logs/
/uploads/

# First-party module sources are tracked - they are the source of truth
# for the ZIPs committed under module-marketplace/. See docs/CONTRIBUTING.md.

# Installed modules (runtime state - what the admin has activated on this
# machine). Fresh clones must stay empty so the "core knows nothing about
# modules" invariant holds.
src/modules/*
!src/modules/.gitkeep

# Legacy generated translation files (translation system is now DB-backed)
# messages/*.json is no longer written. messages-core/*.json is the seed source
# for the Translation table; runtime reads from DB via translation-service.ts.
#
# Anchored to the root. Unanchored it matched every directory of that name at
# any depth, and a module's `pages/admin/messages/` went missing from the
# repository while working perfectly on the machine that wrote it - the
# marketplace zip is built from disk, so nothing downstream noticed.
# `every-module-source-file-is-in-the-repository.test.ts` now would.
/messages/

# User-uploaded files (local fallback when S3 not configured)
public/uploads/*
!public/uploads/.gitkeep
module-sources/__hook-contracts__.ts

# Throwaway Prisma client + tsconfig built by scripts/typecheck-modules.ts.
.typecheck-modules/
tsconfig.modules.generated.json

# Local demo runner written by hand; holds a dev DB URL, never committed.
.run-demo.sh

# What scripts/seed-demo.ts wrote, so --clean can take it back. Per machine.
.seed-ledger.json
