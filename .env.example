# Blysis Environment Configuration
#
# You usually do NOT need this file. The installer writes a complete .env,
# with every secret generated for you:
#
#   curl -fsSL https://raw.githubusercontent.com/INOVIXI/blysis/main/install.sh | sudo bash
#
# Copy this file to .env and fill it in only for a manual (non-Docker) install
# or a development checkout.
#
# A module's own secrets - a payment key, a game server password, a bot token -
# are configured through Admin Panel > Settings after installing that module,
# and sealed into the database. Only platform-wide variables live here, and
# none of them names a module: this file ships with an installation that has
# nothing installed.
#
# The one exception is OAuth sign-in. A module that declares `authProviders`
# names the env vars holding its client id and secret (for example
# AUTH_<PROVIDER>_ID / AUTH_<PROVIDER>_SECRET), because Auth.js builds its
# configuration at process start, before any database read. A provider that
# signs people in some other way names whatever variables that takes instead.
# Either way the module's own page and README name the exact variables, and
# the provider stays inactive until they are set.

# ============================================================
# REQUIRED
# ============================================================

# PostgreSQL connection string. Append ?connection_limit=20 to raise the
# Prisma pool above the default (num_cpu * 2 + 1) for cluster deployments
# - long-running hooks or big batch jobs can otherwise pin every slot.
DATABASE_URL="postgresql://user:password@localhost:5432/blysis"

# Sign JWTs with this. Generate with: openssl rand -base64 32
# Must be identical across every app replica behind the same load balancer.
AUTH_SECRET="your-secret-key-here"

# Canonical URL the platform is served at, and the single source of truth
# for it. Drives OAuth callback URLs, password-reset links, sitemap.xml,
# robots.txt and every OpenGraph/canonical tag (see src/core/lib/app-url.ts).
# AUTH_URL is the Auth.js v5 name; NEXTAUTH_URL is kept for backwards
# compatibility and is checked if AUTH_URL is absent.
#
# Set this to the address visitors actually type. Getting it wrong does not
# break the site, but every canonical URL it publishes will be wrong.
AUTH_URL="http://localhost:3001"

# A word that keeps two installations on one host apart.
#
# Cookies belong to a domain and ignore the port, so a staging site beside a
# live one issues the same names at the same domain and signs the other out.
# Leave it empty unless you run two: changing it signs out everyone holding a
# cookie under the old name.
AUTH_COOKIE_NAMESPACE=
NEXTAUTH_URL="http://localhost:3001"

# Encrypts at-rest credentials with AES-256-GCM: every payment gateway key,
# every integration token and every provider secret an admin pastes into the
# settings screens. REQUIRED in production. Without it the settings endpoint
# refuses to store a credential rather than writing it in the clear, so an
# operator cannot configure a gateway at all.
#
# Rotating it makes every already-stored credential unreadable, and each one
# then reports itself as not configured until it is pasted in again. Keep it
# with your database credentials, not in the repository.
#
# 64-char hex (32 raw bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=""

# ============================================================
# PRODUCTION RECOMMENDED
# ============================================================

# Shared secret for trusted server-to-server calls to internal status
# endpoints (sent as the `x-internal-request` header). Leave unset to disable.
# INTERNAL_API_SECRET=""

# Demo write-protection. Set to 1 on a public demo deployment to reject all
# mutating requests (visitors can browse but not change anything).
# DEMO_MODE=0

# Credentials for the admin account created by `npm run db:seed`. Without
# SEED_ADMIN_PASSWORD the seed generates a random one and prints it once.
# Re-seeding never resets an existing admin's password.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""

# Rate limiting + module status cache. REQUIRED when NODE_ENV=production,
# whatever your worker count. The in-memory fallback is process-local and
# trivially bypassable, so production without Redis does not fall back - it
# denies every rate-limited request with 429, and that includes /api/health,
# so the site reads as down. Set ALLOW_MEMORY_RATE_LIMIT=1 to accept the
# weaker limiter instead; do that only on a true single-worker deployment.
# REDIS_URL="redis://localhost:6379"
# ALLOW_MEMORY_RATE_LIMIT=0

# The return address on outbound mail. Its credential is not here: a mail
# provider module declares which variable or setting holds its API key, and
# core reads it through that declaration. With no provider installed or
# configured, outbound mail degrades to console.log, which is what a
# development checkout wants anyway.
#
# Defaults to noreply@ at this installation's own host, because mail sent from
# a domain you do not control fails SPF and lands in a spam folder.
# EMAIL_FROM="noreply@example.com"

# ============================================================
# OPTIONAL PLATFORM SETTINGS
# ============================================================

NODE_ENV="development"

# Display name + public URL of the site.
#
# WARNING: every NEXT_PUBLIC_* variable is inlined into the JavaScript bundle
# by `next build`, so in the prebuilt Docker image these are frozen to what CI
# had at build time and CANNOT be changed per installation. They are kept as
# fallbacks for deployments that build their own image. Use SITE_NAME for the
# display name and AUTH_URL for the address - both are read at runtime.
NEXT_PUBLIC_APP_NAME="Blysis"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Runtime display name. Preferred over NEXT_PUBLIC_APP_NAME: it is what the
# authenticator-app issuer and outbound e-mail "from" name are built from.
# The `site_name` setting in Admin > Settings overrides it once the DB is up.
# SITE_NAME="Blysis"

# Which installed storage provider handles uploads, by its module id. A
# provider registers itself when it is installed and an operator picks the
# active one in Admin Panel; this overrides that choice, which is useful when
# one deployment of a site has to differ from the setting in its database.
# Unset, uploads are stored on this machine's own disk.
# STORAGE_PROVIDER="

# Where the in-app marketplace fetches module and theme ZIPs from, and where
# the update screen reads its release catalogue. Point this at a fork or an
# internal mirror to serve your own. Must be http(s) - the response is
# unzipped onto disk, so other schemes are rejected and the default is used.
# BLYSIS_MARKETPLACE_BASE=https://raw.githubusercontent.com/INOVIXI/blysis/main

# Which releases the update screen offers, and where the updater stages a
# download. `stable` unless you want pre-releases.
# BLYSIS_UPDATE_CHANNEL="stable"
# BLYSIS_UPDATE_DIR="/opt/blysis"

# Keep a copy of a module's files before an install overwrites them, so a
# failed upgrade can be rolled back. Off by default: it costs disk on every
# install and the marketplace ZIP is the same bytes anyway.
# MODULE_INSTALL_BACKUP=0

# Postgres pool size for this process. Defaults to 10. Raise it for a
# deployment whose hooks or batch jobs hold connections for a long time, and
# remember every replica opens its own pool.
# PGPOOL_MAX=10

# The port the server listens on. The installer and compose set this; it is
# here because a manual `npm start` reads it too.
# PORT=3001

# ============================================================
# WHAT THE SITE SAYS ABOUT ITSELF
# ============================================================
# Fallbacks only. Admin > Settings overrides every one of these once the
# database is up, and that is where an operator is meant to set them.

# SITE_DESCRIPTION=""
# SITE_EMAIL="hello@example.com"

# COMMUNITY_URL=""
# SOCIAL_TWITTER=""
# SOCIAL_YOUTUBE=""
# SOCIAL_INSTAGRAM=""
# SOCIAL_FACEBOOK=""

# An older spelling of the public address, read after AUTH_URL and before
# NEXT_PUBLIC_APP_URL. Kept so an existing .env keeps working; prefer
# AUTH_URL.
# NEXT_PUBLIC_SITE_URL=""

# ============================================================
# SECURITY / HARDENING
# ============================================================

# Extra origins accepted by the CSRF proxy guard. AUTH_URL / NEXTAUTH_URL /
# NEXT_PUBLIC_APP_URL are always allowed. Add staging / preview hosts here.
# CSRF_ALLOWED_ORIGINS="https://staging.example.com,https://preview.example.com"

# Shared secret that lets server-to-server callers bypass the CSRF origin
# check by sending `x-internal-request: <secret>`. Leave unset to disable.
# CSRF_INTERNAL_SECRET=""

# Trusted reverse-proxy IPs. When set, forwarded headers (x-forwarded-for)
# are only honored if the direct connection comes from one of these IPs -
# prevents header spoofing when you're NOT behind a trusted proxy.
# TRUSTED_PROXY_IPS="10.0.0.1,10.0.0.2"

# Make the pre-generated OpenAPI spec (/api/v1/openapi) readable without
# admin auth. Off by default so anonymous clients can't enumerate every
# admin endpoint the platform exposes.
# OPENAPI_PUBLIC=0

# Abort any hook listener that takes longer than this many milliseconds so
# a misbehaving module can't hang login / checkout forever.
# HOOK_LISTENER_TIMEOUT_MS=5000

# Max time (ms) the graceful-shutdown handler has to drain before we
# force-exit. Pick lower than your PM2 kill_timeout.
# SHUTDOWN_GRACE_MS=15000

# How many failed sign-ins lock an account, how long the failures are counted
# over, and how long the lock lasts. Defaults: 10 attempts inside 15 minutes,
# locked for 15 minutes. Admin > Settings overrides the attempt count.
# ACCOUNT_LOCKOUT_ATTEMPTS=10
# ACCOUNT_LOCKOUT_WINDOW_MS=900000
# ACCOUNT_LOCKOUT_MS=900000

# Check a new password against the Have I Been Pwned range API before
# accepting it. Off by default because it is a call to a third party on every
# password change; set to 1 to turn it on.
# PASSWORD_BREACH_CHECK=0

# How long a provider's webhook signature stays acceptable, which is how long
# a captured request could be replayed. Defaults to five minutes.
# WEBHOOK_REPLAY_WINDOW_MS=300000

# An older spelling of AUTH_SECRET, read only if AUTH_SECRET is unset.
# NEXTAUTH_SECRET=""

# ============================================================
# OBSERVABILITY
# ============================================================

# Structured-log filter. debug|info|warn|error - defaults to debug in dev,
# info in production.
# LOG_LEVEL="info"

# Let /api/health report which check failed and why. Off by default: the
# endpoint is public, and "the database is unreachable at db:5432" tells an
# anonymous caller more about the deployment than it needs to.
# HEALTH_DEBUG=0

# When set to 1, scripts/postinstall.ts does NOT regenerate the schema,
# theme, and module registries. Useful for Docker layer caching pipelines
# that call the scripts explicitly after npm ci.
# SKIP_POSTINSTALL=0

# ============================================================
# DOCKER COMPOSE ONLY
# ============================================================
# These are consumed by docker-compose.yml, not by the app directly.
# When running with `docker compose up`, compose injects its own
# DATABASE_URL / REDIS_URL pointing at the sibling db/redis services, so
# the DATABASE_URL above is ignored on the compose path.

# Password for the bundled Postgres container. REQUIRED for docker compose
# (the db and app services fail to start without it). Use hex, not base64 -
# the value is interpolated into postgresql://blysis:<pw>@db:5432/blysis,
# where a '/', '@' or ':' would corrupt the connection string:
#   openssl rand -hex 24
# POSTGRES_PASSWORD=""

# Which image to run, and which tag. The installer pins these; change the tag
# with `blysis update <tag>` rather than editing by hand.
# BLYSIS_IMAGE="ghcr.io/inovixi/blysis"
# BLYSIS_VERSION="latest"

# How the app is published on the host. With TLS, Caddy fronts the app and
# APP_BIND_ADDR is 127.0.0.1 so the container is not also reachable on its
# own port. Without TLS the app publishes APP_PORT directly.
# APP_BIND_ADDR="0.0.0.0"
# APP_PORT="3001"

# Hostname Caddy obtains a certificate for, and the address Let's Encrypt
# sends expiry warnings to. Only used when the `tls` compose profile is on.
# DOMAIN="shop.example.com"
# TLS_EMAIL="you@example.com"
