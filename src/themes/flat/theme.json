{
  "schemaVersion": 2,
  "id": "flat",
  "name": "Flat",
  "description": "Default theme. Neutral gray surfaces, a single blue accent, WCAG AA in both modes.",
  "version": "1.0.0",
  "author": "Blysis",
  "modes": {
    "default": "light",
    "available": {
      "light": {
        "tokens": {
          "colors": {
            "primary": "#2563eb",
            "primaryForeground": "#ffffff",
            "secondary": "#6b6862",
            "accent": "#b45309",
            "background": "#ffffff",
            "foreground": "#1c1b19",
            "muted": "#f5f4f2",
            "mutedForeground": "#6b6862",
            "border": "#e4e2de",
            "card": "#ffffff",
            "cardForeground": "#1c1b19",
            "destructive": "#b91c1c",
            "success": "#15803d",
            "warning": "#b45309"
          },
          "fonts": {
            "heading": "var(--font-outfit), var(--font-inter), system-ui, sans-serif",
            "body": "var(--font-inter), system-ui, sans-serif",
            "mono": "var(--font-jetbrains), ui-monospace, SFMono-Regular, monospace"
          }
        }
      },
      "dark": {
        "tokens": {
          "colors": {
            "primary": "#5191f8",
            "primaryForeground": "#0b0a09",
            "secondary": "#a3a09a",
            "accent": "#fbbf24",
            "background": "#171614",
            "foreground": "#f6f5f4",
            "muted": "#2c2b28",
            "mutedForeground": "#a8a59f",
            "border": "#403e3a",
            "card": "#21201e",
            "cardForeground": "#f6f5f4",
            "destructive": "#f87171",
            "success": "#4ade80",
            "warning": "#fbbf24"
          },
          "fonts": {
            "heading": "var(--font-outfit), var(--font-inter), system-ui, sans-serif",
            "body": "var(--font-inter), system-ui, sans-serif",
            "mono": "var(--font-jetbrains), ui-monospace, SFMono-Regular, monospace"
          }
        }
      }
    }
  },
  "tokens": {
    "colors": {
      "primary": {
        "type": "color",
        "group": "Brand"
      },
      "secondary": {
        "type": "color",
        "group": "Brand"
      },
      "accent": {
        "type": "color",
        "group": "Brand"
      },
      "background": {
        "type": "color",
        "group": "Surface"
      },
      "foreground": {
        "type": "color",
        "group": "Surface"
      },
      "muted": {
        "type": "color",
        "group": "Surface"
      },
      "mutedForeground": {
        "type": "color",
        "group": "Surface"
      },
      "border": {
        "type": "color",
        "group": "Surface"
      },
      "card": {
        "type": "color",
        "group": "Surface"
      },
      "cardForeground": {
        "type": "color",
        "group": "Surface"
      },
      "destructive": {
        "type": "color",
        "group": "State"
      },
      "success": {
        "type": "color",
        "group": "State"
      },
      "warning": {
        "type": "color",
        "group": "State"
      },
      "primaryForeground": {
        "type": "color",
        "group": "Brand"
      }
    },
    "fonts": {
      "heading": {
        "type": "font",
        "default": "Inter, system-ui, sans-serif"
      },
      "body": {
        "type": "font",
        "default": "Inter, system-ui, sans-serif"
      },
      "mono": {
        "type": "font",
        "default": "ui-monospace, SFMono-Regular, monospace"
      }
    },
    "radius": {
      "type": "select",
      "default": "md",
      "options": [
        {
          "value": "none",
          "label": "Square (0)"
        },
        {
          "value": "sm",
          "label": "Subtle (0.25rem)"
        },
        {
          "value": "md",
          "label": "Rounded (0.5rem)"
        },
        {
          "value": "lg",
          "label": "Soft (0.75rem)"
        }
      ]
    }
  },
  "settings": {
    "hero": {
      "label": "Hero",
      "icon": "Image",
      "fields": {
        "enabled": {
          "type": "toggle",
          "label": "Show hero on homepage",
          "default": false,
          "labelKey": "theme_flat_hero_enabled"
        },
        "title": {
          "type": "text",
          "label": "Title",
          "default": "Welcome",
          "labelKey": "theme_flat_hero_title"
        },
        "subtitle": {
          "type": "text",
          "label": "Subtitle",
          "default": "A clean starting point for your community.",
          "labelKey": "theme_flat_hero_subtitle"
        },
        "ctaText": {
          "type": "text",
          "label": "Button text",
          "default": "Get started",
          "labelKey": "theme_flat_hero_ctaText"
        },
        "ctaHref": {
          "type": "url",
          "label": "Button link",
          "labelKey": "theme_flat_hero_ctaHref"
        },
        "backgroundImage": {
          "type": "image",
          "label": "Background image",
          "labelKey": "theme_flat_hero_backgroundImage"
        }
      },
      "labelKey": "theme_flat_hero"
    }
  },
  "components": {
    "Hero": "components/Hero.tsx"
  },
