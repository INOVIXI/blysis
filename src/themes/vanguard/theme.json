      "heading": {
        "type": "font",
        "default": "var(--font-vanguard-heading), var(--font-vanguard-headingExtra), system-ui, sans-serif"
      },
      "body": {
        "type": "font",
        "default": "var(--font-vanguard-body), var(--font-vanguard-bodyExtra), var(--font-inter), system-ui, sans-serif"
      },
      "mono": {
        "type": "font",
        "default": "var(--font-jetbrains), ui-monospace, SFMono-Regular, monospace"
      }
    },
    "radius": {
      "type": "select",
      "default": "md",
      "options": [
        {
          "value": "none",
          "label": "Square (0)"
        },
        {
          "value": "sm",
          "label": "Subtle (0.25rem)"
        },
        {
          "value": "md",
          "label": "Rounded (0.5rem)"
        },
        {
          "value": "lg",
          "label": "Soft (0.75rem)"
        }
      ]
    }
  },
  "fontFiles": {
    "heading": [
      {
        "file": "fonts/ChakraPetch-Medium.woff2",
        "weight": "500",
        "style": "normal"
      },
      {
        "file": "fonts/ChakraPetch-SemiBold.woff2",
        "weight": "600",
        "style": "normal"
      },
      {
        "file": "fonts/ChakraPetch-Bold.woff2",
        "weight": "700",
        "style": "normal"
      }
    ],
    "headingExtra": [
      {
        "file": "fonts/Exo2-Cyrillic.woff2",
        "weight": "500 700",
        "style": "normal"
      }
    ],
    "body": [
      {
        "file": "fonts/Figtree-Variable.woff2",
        "weight": "300 900",
        "style": "normal"
      }
    ],
    "bodyExtra": [
      {
        "file": "fonts/Onest-Extra.woff2",
        "weight": "300 900",
        "style": "normal"
      }
    ]
  },
  "stylesheet": "theme.css",
  "settings": {
    "hero": {
      "label": "Hero",
      "icon": "Image",
      "labelKey": "theme_vanguard_hero",
      "fields": {
        "enabled": {
          "type": "toggle",
          "label": "Show the hero on the homepage",
          "default": true,
          "labelKey": "theme_vanguard_hero_enabled"
        },
        "tag": {
          "type": "text",
          "label": "Small label above the heading",
          "max": 60,
          "labelKey": "theme_vanguard_hero_tag"
        },
        "title": {
          "type": "text",
          "label": "Heading",
          "max": 120,
          "labelKey": "theme_vanguard_hero_title"
        },
        "subtitle": {
          "type": "text",
          "label": "Line under the heading",
          "max": 300,
          "labelKey": "theme_vanguard_hero_subtitle"
        },
        "ctaText": {
          "type": "text",
          "label": "Button text",
          "max": 40,
          "labelKey": "theme_vanguard_hero_ctaText"
        },
        "ctaHref": {
          "type": "text",
          "label": "Where the button goes",
          "max": 300,
          "labelKey": "theme_vanguard_hero_ctaHref"
        }
      }
    },
    "auth": {
      "label": "Sign-in screen",
      "icon": "LogIn",
      "labelKey": "theme_vanguard_auth",
      "fields": {
        "tag": {
          "type": "text",
          "label": "Small label on the sign-in screen",
          "max": 60,
          "labelKey": "theme_vanguard_auth_tag"
        },
        "title": {
          "type": "text",
          "label": "Heading on the sign-in screen",
          "max": 120,
          "labelKey": "theme_vanguard_auth_title"
        },
        "subtitle": {
          "type": "text",
          "label": "Line under that heading",
          "max": 300,
          "labelKey": "theme_vanguard_auth_subtitle"
        }
      }
    }
  },
  "components": {
    "SiteShell": "components/SiteShell.tsx",
    "PageHeader": "components/PageHeader.tsx",
    "AuthFrame": "components/AuthFrame.tsx"
  },
