{
  "schemaVersion": 2,
  "id": "quarry",
  "name": "Quarry",
  "description": "Flat charcoal panels, chunky buttons that press down and heavy block capitals: a game-server look with the server's address one click from the homepage. Dark and light.",
  "version": "1.1.0",
  "author": "Blysis",
  "modes": {
    "default": "dark",
    "available": {
      "dark": {
        "tokens": {
          "colors": {
            "primary": "#5cc72a",
            "primaryForeground": "#0b1a05",
            "secondary": "#2a2e37",
            "secondaryForeground": "#f3f5f8",
            "accent": "#23c4d8",
            "accentForeground": "#06252a",
            "background": "#15171c",
            "foreground": "#f3f5f8",
            "muted": "#2a2e37",
            "mutedForeground": "#a9b0bd",
            "border": "#33384a",
            "card": "#20232a",
            "cardForeground": "#f3f5f8",
            "destructive": "#f26b6b",
            "destructiveForeground": "#1f0606",
            "success": "#5cc72a",
            "successForeground": "#0b1a05",
            "warning": "#f5a524",
            "warningForeground": "#241500",
            "edge": "#0b0d11",
            "stage": "#101216",
            "stageForeground": "#ffffff",
            "stageMuted": "#c9ced8"
          }
        }
      },
      "light": {
        "tokens": {
          "colors": {
            "primary": "#2b7f10",
            "primaryForeground": "#ffffff",
            "secondary": "#e3e7ec",
            "secondaryForeground": "#15171c",
            "accent": "#0d7482",
            "accentForeground": "#ffffff",
            "background": "#eef1f4",
            "foreground": "#15171c",
            "muted": "#e3e7ec",
            "mutedForeground": "#4f5766",
            "border": "#d3d9e1",
            "card": "#ffffff",
            "cardForeground": "#15171c",
            "destructive": "#c42828",
            "destructiveForeground": "#ffffff",
            "success": "#15803d",
            "successForeground": "#ffffff",
            "warning": "#a15c00",
            "warningForeground": "#ffffff",
            "edge": "#c5ccd6",
            "stage": "#15171c",
            "stageForeground": "#ffffff",
            "stageMuted": "#c9ced8"
          }
        }
      }
    }
  },
  "tokens": {
    "colors": {
      "primary": {
        "type": "color",
        "group": "Brand"
      },
      "primaryForeground": {
        "type": "color",
        "group": "Brand"
      },
      "accent": {
        "type": "color",
        "group": "Brand"
      },
      "accentForeground": {
        "type": "color",
        "group": "Brand"
      },
      "secondary": {
        "type": "color",
        "group": "Brand"
      },
      "background": {
        "type": "color",
        "group": "Surface"
      },
      "foreground": {
        "type": "color",
        "group": "Surface"
      },
      "muted": {
        "type": "color",
        "group": "Surface"
      },
      "mutedForeground": {
        "type": "color",
        "group": "Surface"
      },
      "border": {
        "type": "color",
        "group": "Surface"
      },
      "card": {
        "type": "color",
        "group": "Surface"
      },
      "cardForeground": {
        "type": "color",
        "group": "Surface"
      },
      "edge": {
        "type": "color",
        "group": "Surface"
      },
      "destructive": {
        "type": "color",
        "group": "State"
      },
      "success": {
        "type": "color",
        "group": "State"
      },
      "warning": {
        "type": "color",
        "group": "State"
      },
      "stage": {
        "type": "color",
        "group": "Hero"
      },
      "stageForeground": {
        "type": "color",
        "group": "Hero"
      },
      "stageMuted": {
        "type": "color",
        "group": "Hero"
      }
    },
    "fonts": {
      "heading": {
        "type": "font",
        "default": "var(--font-quarry-heading), var(--font-quarry-headingExtra), system-ui, sans-serif"
      },
      "body": {
        "type": "font",
        "default": "var(--font-quarry-body), var(--font-inter), system-ui, sans-serif"
      },
      "mono": {
        "type": "font",
        "default": "var(--font-jetbrains), ui-monospace, SFMono-Regular, monospace"
      }
    },
    "radius": {
      "type": "select",
      "default": "sm",
      "options": [
        {
          "value": "none",
          "label": "Square (0)"
        },
        {
          "value": "sm",
          "label": "Subtle (0.25rem)"
        },
        {
          "value": "md",
          "label": "Rounded (0.5rem)"
        },
        {
          "value": "lg",
          "label": "Soft (0.75rem)"
        }
      ]
    }
  },
  "fontFiles": {
    "heading": [
      {
        "file": "fonts/Tektur-Heading.woff2",
        "weight": "600 900",
        "style": "normal"
      }
    ],
    "headingExtra": [
      {
        "file": "fonts/Exo2-Currency.woff2",
        "weight": "600 900",
        "style": "normal"
      }
    ],
    "body": [
      {
        "file": "fonts/Onest-Body.woff2",
        "weight": "300 900",
        "style": "normal"
      }
    ]
  },
  "stylesheet": "theme.css",
  "settings": {
    "hero": {
      "label": "Hero",
      "icon": "Image",
      "labelKey": "theme_quarry_hero",
      "fields": {
        "enabled": {
          "type": "toggle",
          "label": "Show the hero on the homepage",
          "default": true,
          "labelKey": "theme_quarry_hero_enabled"
        },
        "tag": {
          "type": "text",
          "label": "Small label above the heading",
          "max": 60,
          "labelKey": "theme_quarry_hero_tag"
        },
        "title": {
          "type": "text",
          "label": "Heading",
          "max": 120,
          "labelKey": "theme_quarry_hero_title"
        },
        "subtitle": {
          "type": "text",
          "label": "Line under the heading",
          "max": 300,
          "labelKey": "theme_quarry_hero_subtitle"
        },
        "address": {
          "type": "text",
          "label": "Server address visitors can copy",
          "max": 120,
          "labelKey": "theme_quarry_hero_address"
        },
        "ctaText": {
          "type": "text",
          "label": "Button text",
          "max": 40,
          "labelKey": "theme_quarry_hero_ctaText"
        },
        "ctaHref": {
          "type": "text",
          "label": "Where the button goes",
          "max": 300,
          "labelKey": "theme_quarry_hero_ctaHref"
        },
        "backgroundImage": {
          "type": "image",
          "label": "Background picture",
          "labelKey": "theme_quarry_hero_backgroundImage"
        }
      }
    },
    "stats": {
      "label": "Numbers row",
      "icon": "BarChart3",
      "labelKey": "theme_quarry_stats",
      "fields": {
        "tile1Value": {
          "type": "text",
          "label": "Tile 1: the number",
          "max": 40,
          "labelKey": "theme_quarry_stats_tile1Value"
        },
        "tile1Label": {
          "type": "text",
          "label": "Tile 1: what it counts",
          "max": 80,
          "labelKey": "theme_quarry_stats_tile1Label"
        },
        "tile1Icon": {
          "type": "text",
          "label": "Tile 1: icon (a Lucide name, such as Trophy)",
          "max": 64,
          "labelKey": "theme_quarry_stats_tile1Icon"
        },
        "tile2Value": {
          "type": "text",
          "label": "Tile 2: the number",
          "max": 40,
          "labelKey": "theme_quarry_stats_tile2Value"
        },
        "tile2Label": {
          "type": "text",
          "label": "Tile 2: what it counts",
          "max": 80,
          "labelKey": "theme_quarry_stats_tile2Label"
        },
        "tile2Icon": {
          "type": "text",
          "label": "Tile 2: icon (a Lucide name, such as Trophy)",
          "max": 64,
          "labelKey": "theme_quarry_stats_tile2Icon"
        },
        "tile3Value": {
          "type": "text",
          "label": "Tile 3: the number",
          "max": 40,
          "labelKey": "theme_quarry_stats_tile3Value"
        },
        "tile3Label": {
          "type": "text",
          "label": "Tile 3: what it counts",
          "max": 80,
          "labelKey": "theme_quarry_stats_tile3Label"
        },
        "tile3Icon": {
          "type": "text",
          "label": "Tile 3: icon (a Lucide name, such as Trophy)",
          "max": 64,
          "labelKey": "theme_quarry_stats_tile3Icon"
        }
      }
    }
  },
  "layouts": {
    "home": {
      "rows": [
        {
          "split": "1",
          "cells": [
            [
              {
                "key": "stats",
                "block": "core.stats",
                "settings": {
                  "tile1Value": {
                    "$theme": "stats.tile1Value"
                  },
                  "tile1Label": {
                    "$theme": "stats.tile1Label"
                  },
                  "tile1Icon": {
                    "$theme": "stats.tile1Icon"
                  },
                  "tile2Value": {
                    "$theme": "stats.tile2Value"
                  },
                  "tile2Label": {
                    "$theme": "stats.tile2Label"
                  },
                  "tile2Icon": {
                    "$theme": "stats.tile2Icon"
                  },
                  "tile3Value": {
                    "$theme": "stats.tile3Value"
                  },
                  "tile3Label": {
                    "$theme": "stats.tile3Label"
                  },
                  "tile3Icon": {
                    "$theme": "stats.tile3Icon"
                  }
                }
              }
            ]
          ]
        },
        {
          "split": "1",
          "cells": [
            [
              {
                "key": "news",
                "block": "blog.news",
                "settings": {
                  "variant": "featured",
                  "kicker": "quarry.newsKicker",
                  "title": "quarry.newsTitle",
                  "allLink": true
                }
              }
            ]
          ]
        },
        {
          "split": "1",
          "cells": [
            [
              {
                "key": "modes",
                "block": "servers.cards",
                "settings": {
                  "kicker": "quarry.modesKicker",
                  "title": "quarry.modesTitle"
                }
              }
            ]
          ]
        },
        {
          "split": "1",
          "cells": [
            [
              {
                "key": "shop",
                "block": "store.products",
                "settings": {
                  "kicker": "quarry.shopKicker",
                  "title": "quarry.shopTitle",
                  "count": 4
                }
              }
            ]
          ]
        },
        {
          "split": "1-1-1",
          "rest": 0,
          "cells": [
            [
              {
                "key": "voters",
                "block": "leaderboard.board",
                "settings": {
                  "board": "voters",
                  "title": "quarry.votersTitle"
                }
              }
            ],
            [
              {
                "key": "team",
                "block": "staff.online",
                "settings": {
                  "title": "quarry.teamTitle"
                }
              }
            ],
            [
              {
                "key": "forum",
                "block": "forum.latest-topics",
                "settings": {
                  "title": "quarry.forumTitle"
                }
              }
            ]
          ]
        }
      ],
      "hidden": [
        "servers.ServerStatusWidget",
        "leaderboard.LeaderboardWidget",
        "forum.LatestTopicsWidget"
      ]
    }
  },
  "components": {
    "SiteShell": "components/SiteShell.tsx",
    "PageHeader": "components/PageHeader.tsx",
    "AuthFrame": "components/AuthFrame.tsx"
  },
