{
  "schemaVersion": 2,
  "id": "quarry",
  "name": "Quarry",
  "description": "Flat charcoal panels, chunky buttons that press down and heavy block capitals: a game-server look with the server's address one click from the homepage. Dark and light.",
  "version": "1.0.0",
  "author": "Blysis",
  "modes": {
    "default": "dark",
    "available": {
      "dark": {
        "tokens": {
          "colors": {
            "primary": "#5cc72a",
            "primaryForeground": "#0b1a05",
            "secondary": "#2a2e37",
            "secondaryForeground": "#f3f5f8",
            "accent": "#23c4d8",
            "accentForeground": "#06252a",
            "background": "#15171c",
            "foreground": "#f3f5f8",
            "muted": "#2a2e37",
            "mutedForeground": "#a9b0bd",
            "border": "#33384a",
            "card": "#20232a",
            "cardForeground": "#f3f5f8",
            "destructive": "#f26b6b",
            "destructiveForeground": "#1f0606",
            "success": "#5cc72a",
            "successForeground": "#0b1a05",
            "warning": "#f5a524",
            "warningForeground": "#241500",
            "edge": "#0b0d11",
            "stage": "#101216",
            "stageForeground": "#ffffff",
            "stageMuted": "#c9ced8"
          }
        }
      },
      "light": {
        "tokens": {
          "colors": {
            "primary": "#2b7f10",
            "primaryForeground": "#ffffff",
            "secondary": "#e3e7ec",
            "secondaryForeground": "#15171c",
            "accent": "#0d7482",
            "accentForeground": "#ffffff",
            "background": "#eef1f4",
            "foreground": "#15171c",
            "muted": "#e3e7ec",
            "mutedForeground": "#4f5766",
            "border": "#d3d9e1",
            "card": "#ffffff",
            "cardForeground": "#15171c",
            "destructive": "#c42828",
            "destructiveForeground": "#ffffff",
            "success": "#15803d",
            "successForeground": "#ffffff",
            "warning": "#a15c00",
            "warningForeground": "#ffffff",
            "edge": "#c5ccd6",
            "stage": "#15171c",
            "stageForeground": "#ffffff",
            "stageMuted": "#c9ced8"
          }
        }
      }
    }
  },
  "tokens": {
    "colors": {
      "primary": {
        "type": "color",
        "group": "Brand"
      },
      "primaryForeground": {
        "type": "color",
        "group": "Brand"
      },
      "accent": {
        "type": "color",
        "group": "Brand"
      },
