        "type": "color",
        "group": "Brand"
      },
      "secondary": {
        "type": "color",
        "group": "Brand"
      },
      "background": {
        "type": "color",
        "group": "Surface"
      },
      "foreground": {
        "type": "color",
        "group": "Surface"
      },
      "muted": {
        "type": "color",
        "group": "Surface"
      },
      "mutedForeground": {
        "type": "color",
        "group": "Surface"
      },
      "border": {
        "type": "color",
        "group": "Surface"
      },
      "card": {
        "type": "color",
        "group": "Surface"
      },
      "cardForeground": {
        "type": "color",
        "group": "Surface"
      },
      "edge": {
        "type": "color",
        "group": "Surface"
      },
      "destructive": {
        "type": "color",
        "group": "State"
      },
      "success": {
        "type": "color",
        "group": "State"
      },
      "warning": {
        "type": "color",
        "group": "State"
      },
      "stage": {
        "type": "color",
        "group": "Hero"
      },
      "stageForeground": {
        "type": "color",
        "group": "Hero"
      },
      "stageMuted": {
        "type": "color",
        "group": "Hero"
      }
    },
    "fonts": {
      "heading": {
        "type": "font",
        "default": "var(--font-quarry-heading), var(--font-quarry-headingExtra), system-ui, sans-serif"
      },
      "body": {
        "type": "font",
        "default": "var(--font-quarry-body), var(--font-inter), system-ui, sans-serif"
      },
      "mono": {
        "type": "font",
        "default": "var(--font-jetbrains), ui-monospace, SFMono-Regular, monospace"
      }
    },
    "radius": {
      "type": "select",
      "default": "sm",
      "options": [
        {
          "value": "none",
          "label": "Square (0)"
        },
        {
          "value": "sm",
          "label": "Subtle (0.25rem)"
        },
        {
          "value": "md",
          "label": "Rounded (0.5rem)"
        },
        {
          "value": "lg",
          "label": "Soft (0.75rem)"
        }
      ]
    }
  },
  "fontFiles": {
    "heading": [
      {
        "file": "fonts/Tektur-Heading.woff2",
        "weight": "600 900",
        "style": "normal"
      }
    ],
    "headingExtra": [
      {
        "file": "fonts/Exo2-Currency.woff2",
        "weight": "600 900",
        "style": "normal"
      }
    ],
    "body": [
      {
        "file": "fonts/Onest-Body.woff2",
        "weight": "300 900",
        "style": "normal"
      }
    ]
  },
  "stylesheet": "theme.css",
  "settings": {
    "hero": {
      "label": "Hero",
      "icon": "Image",
      "labelKey": "theme_quarry_hero",
      "fields": {
        "enabled": {
          "type": "toggle",
          "label": "Show the hero on the homepage",
          "default": true,
          "labelKey": "theme_quarry_hero_enabled"
        },
        "tag": {
          "type": "text",
          "label": "Small label above the heading",
          "max": 60,
          "labelKey": "theme_quarry_hero_tag"
        },
        "title": {
          "type": "text",
          "label": "Heading",
          "max": 120,
          "labelKey": "theme_quarry_hero_title"
        },
        "subtitle": {
          "type": "text",
          "label": "Line under the heading",
          "max": 300,
          "labelKey": "theme_quarry_hero_subtitle"
        },
        "address": {
          "type": "text",
          "label": "Server address visitors can copy",
          "max": 120,
          "labelKey": "theme_quarry_hero_address"
        },
        "ctaText": {
          "type": "text",
          "label": "Button text",
          "max": 40,
          "labelKey": "theme_quarry_hero_ctaText"
        },
        "ctaHref": {
          "type": "text",
          "label": "Where the button goes",
          "max": 300,
          "labelKey": "theme_quarry_hero_ctaHref"
        },
        "backgroundImage": {
          "type": "image",
          "label": "Background picture",
          "labelKey": "theme_quarry_hero_backgroundImage"
        }
      }
    }
  },
  "components": {
    "SiteShell": "components/SiteShell.tsx",
    "PageHeader": "components/PageHeader.tsx",
    "AuthFrame": "components/AuthFrame.tsx"
  },
