{
  "name": "blysis",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "description": "Open source game server management platform",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:themes": "npx tsx scripts/generate-theme-registry.ts",
    "build:marketplace": "bash scripts/build-marketplace.sh",
    "db:merge": "npx tsx scripts/merge-schemas.ts",
    "postinstall": "npx tsx scripts/postinstall.ts",
    "patch:next": "npx tsx scripts/patch-next-agent-rules.ts",
    "check:style": "npx tsx scripts/check-no-em-dash.ts",
    "predev": "npm run patch:next && npm run db:merge && npm run generate:themes && npx tsx scripts/generate-registry.ts && npx tsx scripts/generate-openapi.ts",
    "dev": "sh scripts/with-scratch.sh NEXT_DEV=1 next dev --turbopack --port 3001 --hostname 0.0.0.0",
    "prebuild": "npm run db:merge && npm run generate:themes && npx tsx scripts/generate-registry.ts && npx tsx scripts/generate-openapi.ts",
    "build": "sh scripts/with-scratch.sh next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:modules": "npx tsx scripts/typecheck-modules.ts",
    "verify": "npx tsx scripts/verify.ts",
    "test": "sh scripts/with-scratch.sh vitest run",
    "test:watch": "sh scripts/with-scratch.sh vitest",
    "test:coverage": "sh scripts/with-scratch.sh vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "npx tsx scripts/apply-migrations.ts",
    "db:migrate:bootstrap": "npx tsx scripts/apply-migrations.ts --bootstrap",
    "db:migrate:dry": "npx tsx scripts/apply-migrations.ts --dry-run",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "seed:demo": "npx tsx scripts/seed-demo.ts",
    "demo:reset": "npx tsx scripts/demo-reset.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "clean": "rm -rf .next .next-prod node_modules/.cache .tmp",
    "test:e2e:ui": "npx playwright test --ui",
    "create:module": "npx tsx scripts/create-module.ts",
    "validate:module": "npx tsx scripts/validate-module.ts",
    "module": "npx tsx scripts/module-dev.ts",
    "module:add-hook": "npx tsx scripts/module-dev.ts add-hook",
    "module:add-slot": "npx tsx scripts/module-dev.ts add-slot",
    "module:add-cron": "npx tsx scripts/module-dev.ts add-cron",
    "module:add-search": "npx tsx scripts/module-dev.ts add-search",
    "module:list": "npx tsx scripts/module-dev.ts list-modules",
    "report:permissions": "npx tsx scripts/permission-report.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1129.0",
    "@next/bundle-analyzer": "^16.3.6",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/nprogress": "^0.2.3",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.15",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^4.2.0",
    "lucide-react": "^1.45.0",
    "marked": "^18.0.13",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "mysql2": "^3.24.4",
    "next": "^16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.9.0",
    "nodemailer": "^10.0.10",
    "nprogress": "^0.2.0",
    "otpauth": "^9.5.2",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "qrcode": "^1.5.4",
    "rcon-client": "^4.2.5",
    "react": "19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.0",
    "redis": "^6.2.1",
    "resend": "^6.27.0",
    "sonner": "^2.0.7",
    "stripe": "^22.6.2",
    "swagger-ui-react": "^5.32.15",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "mysql2": "$mysql2",
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.1": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "core-js-pure@3.50.0": true,
    "tree-sitter@0.21.1": true,
    "tree-sitter@0.22.4": true,
    "tree-sitter-json@0.24.8": true,
    "@tree-sitter-grammars/tree-sitter-yaml@0.7.1": true,
    "@scarf/scarf": false
  }
}
