// Core Prisma Schema - base models only
// Module models are merged from module-sources/*/schema.prisma
// DO NOT edit prisma/schema.prisma directly - it is auto-generated by merge-
// schemas.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== CORE MODELS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String?
  avatar        String?
  locale        String    @default("en")
  currency      String    @default("USD")
  emailVerified DateTime?
  isBanned         Boolean   @default(false)
  banReason        String?
  bannedAt         DateTime?
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  // Failed-login throttling. Per-IP rate limiting only slows brute force
  // from a single attacker host; a distributed credential-stuffing attack
  // can pepper a single account from thousands of IPs without tripping
  // any IP limit. These fields let us lock the account itself after too
  // many failures in a row and reset on any successful login.
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /**
   * The role shown for this member: their highest-priority one.
   *
   * Not "the role they have" any more - that is `roles`. This is a cache of
   * the top of that set, kept because a member list of fifty rows draws fifty
   * badges and computing the maximum per row is a join per row for a value
   * that changes rarely. `syncDisplayedRole` is the only writer, and a gate
   * proves it against the set.
   */
  role   Role?   @relation(fields: [roleId], references: [id])
  roleId String?

  /** Every role this member holds, each with its own expiry and origin. */
  roles  UserRole[]

  accounts Account[]
  sessions Session[]

  // Core relations
  activityLogs     ActivityLog[]      @relation("ActivityLogs")
  apiKeys          ApiKey[]           @relation("ApiKeys")
  mediaItems       MediaItem[]
  revisions        Revision[]         @relation("RevisionAuthor")
  activityFeed     ActivityFeedItem[] @relation("ActivityActor")
  restrictions     UserRestriction[]  @relation("UserRestrictions")
  warnings         UserWarning[]      @relation("UserWarnings")
  warningsIssued   UserWarning[]      @relation("WarningIssuer")
  notifPrefs       NotificationPreference[] @relation("UserNotifPrefs")
  conversations    ConversationParticipant[] @relation("ConversationMember")
  messages         Message[]          @relation("MessageAuthor")
  loginSessions    UserSession[]      @relation("UserSessions")
  themeCustomizations   ThemeCustomization[] @relation("ThemeCustomizationUpdater")
  themeSettingUpdates   ThemeSetting[]       @relation("ThemeSettingUpdater")

  // Module relations are injected here by merge-schemas.ts
  // @@MODULE_RELATIONS

  @@index([roleId])

  // The admin dashboard's signup chart scans a date window.
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  displayName String
  color       String?
  /// Declarations an operator wrote, rendered beside every name wearing this
  /// role. Checked by lib/role-css.ts on the way in and again on the way out:
  /// a closing brace ends the rule this site wrote and starts one of theirs.
  nameCss     String?
  badgeCss    String?
  priority    Int          @default(0)
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  rolePermissions RolePermission[]
  users           User[]
  members         UserRole[]
}

/**
 * One role a member holds.
 *
 * A member used to hold exactly one, which is why handing out a rank had to
 * remember what to put back: buying a rank could take somebody's moderator
 * status away and give it back a month later. A set has no such problem, and a
 * temporary role is just a row with a time on it.
 *
 * Roles only ever grant. Two of them cannot disagree, so nothing has to
 * arbitrate between them and "which role wins" is a question this shape
 * refuses to create. The only refusal is an exception written against one
 * member or one role, deliberately.
 */
model UserRole {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedAt DateTime  @default(now())
  /** Null is permanent. A time here is what a timed grant used to be. */
  expiresAt DateTime?
  /**
   * A free label naming what granted it, so core need not know what kinds of
   * thing do: a purchase, a campaign, an operator with a form.
   */
  source    String    @default("manual")

  // One row per member per role: granting the same rank again extends this
  // row rather than adding a second that would lapse independently.
  @@unique([userId, roleId])
  // The sweep asks for the grants whose time is up and nothing else.
  @@index([expiresAt])
  @@index([roleId])
}


/**
 * What one role says about one permission: yes, never, or - by having no row
 * at all - nothing.
 *
 * The third state is the one that makes the system usable. A member holds a
 * set of roles and may do the union of what they allow, so without a refusal
 * an operator can only ever build up: taking posting away from one person
 * means unpicking every role they hold. `NEVER` is absolute - it beats a yes
 * from any other role the member holds - which is how a "muted" role works.
 *
 * Keyed by the permission's name rather than by a row in a table of names. The
 * vocabulary comes from core and from the installed manifests, so a table of
 * names is a second copy of it that has to be kept in step, and was: the old
 * `Permission` table held four rows on an installation whose manifests declare
 * a hundred and three.
 */
model RolePermission {
  id         String          @id @default(cuid())
  roleId     String
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /** `namespace.action`, as declared by core or by a module's manifest. */
  permission String
  state      PermissionState

  @@unique([roleId, permission])
  @@index([permission])
}

enum PermissionState {
  ALLOW
  NEVER
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  module    String   @default("core")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
}

model Translation {
  id        String   @id @default(cuid())
  locale    String
  namespace String
  key       String
  value     String   @db.Text
  module    String   @default("core")
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key, module])
  @@index([module])
}

model ModuleConfig {
  id        String   @id
  name      String
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  order     Int      @default(0)
  // Tamper-evidence for installed modules: SHA-256 of the module.json
  // bytes at install/update time + who installed it + when. Ops can
  // diff the on-disk manifest against `manifestHash` to detect an
  // out-of-band edit (dev box, compromised deploy, etc.).
  manifestHash      String?
  installedAt       DateTime?
  installedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Admin customization for a theme (mode-aware). `overrides` is a DIFF
/// against the manifest defaults - resetting a field clears it from
/// `overrides`, and deleting the row restores every default at once.
model ThemeCustomization {
  id          String   @id @default(cuid())
  themeId     String
  mode        String
  overrides   Json     @default("{}")
  updatedById String?
  updatedBy   User?    @relation("ThemeCustomizationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([themeId, mode])
  @@index([updatedById])
}

/// Per-theme key/value settings (grouped). Admin-managed; read by theme
/// renderers to replace or extend manifest defaults.
model ThemeSetting {
  id          String   @id @default(cuid())
  themeId     String
  groupKey    String
  key         String
  value       Json
  updatedById String?
  updatedBy   User?    @relation("ThemeSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([themeId, groupKey, key])
  @@index([updatedById])
}

/// Singleton (id=1) - the currently active theme + colour mode for the
/// entire site. Use ThemeState.upsert({ where: { id: 1 }, … }) to change.
model ThemeState {
  id        Int      @id @default(1)
  themeId   String
  mode      String
  updatedAt DateTime @updatedAt
}

// Central media library. Every file uploaded via /api/v1/upload is recorded
// here so it can be browsed, searched, reused, and deleted from one place.
model MediaItem {
  id         String   @id @default(cuid())
  filename   String   // Original filename
  url        String   // Public URL (local or S3)
  storagePath String  // Storage path/key for delete
  mimeType   String
  size       Int      // Bytes
  width      Int?     // For images
  height     Int?
  alt        String?  // Accessibility / SEO
  uploadedById String?
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([uploadedById])
  @@index([mimeType])
  @@index([createdAt])
}

// Generic content revision history. Modules call recordRevision() before
// updates/deletes to snapshot the previous state. The (resource, resourceId)
// pair identifies the entity; data holds the JSON snapshot.
model Revision {
  id          String   @id @default(cuid())
  resource    String   // e.g. "blog.article", "store.product"
  resourceId  String   // entity primary key
  data        Json     // serialized snapshot before the change
  action      String   // "update" | "delete"
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull, name: "RevisionAuthor")
  createdAt   DateTime @default(now())

  @@index([resource, resourceId])
  @@index([authorId])
  @@index([createdAt])
}

// User warnings issued by moderators. Configurable point values; when
// a user accumulates enough points, automatic actions can fire (mute,
// ban, etc.) via hook listeners.
/// Keeping a member out of one part of the site rather than all of it.
///
/// `scope` is a word this table never interprets. `site` is the one core
/// names, because it is not a module; everything else is whatever module is
/// asking about its own room. See lib/restrictions.ts.
model UserRestriction {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserRestrictions", fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  reason    String?
  /// Null never runs out. The clock is why an operator reaches for this
  /// instead of a ban.
  expiresAt DateTime?
  issuedById String?
  createdAt DateTime  @default(now())

  @@index([userId, scope])
  @@index([expiresAt])
}

model UserWarning {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserWarnings")
  issuedById  String?
  issuedBy    User?    @relation(fields: [issuedById], references: [id], onDelete: SetNull, name: "WarningIssuer")
  reason      String
  points      Int      @default(1)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([issuedById])
  @@index([isActive, expiresAt])
}

// Cross-module unified activity feed.
// Modules emit hooks (e.g. blog.article.created) and a core listener
// records them here as feed items. Rendered on public profile pages
// and a sitewide /activity stream.
model ActivityFeedItem {
  id         String   @id @default(cuid())
  type       String   // e.g. "blog.article.created", "store.order.completed"
  actorId    String?  // user who triggered it
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Cascade, name: "ActivityActor")
  title      String   // human-readable headline
  body       String?  // optional excerpt / preview
  href       String?  // link to the entity
  icon       String?  // Lucide icon name for the feed UI
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([type])
  @@index([createdAt])
  @@index([isPublic, createdAt])
}

// Granular per-resource permission grants on top of role-based defaults.
// See docs in core/lib/permissions.ts for resolution order.
model ResourcePermission {
  id            String   @id @default(cuid())
  resource      String   // e.g. "blog.article"
  resourceId    String?  // null = applies to all entities of that resource
  action        String   // "view" | "create" | "edit" | "delete" | "*"
  principalType String   // "role" | "user"
  principalId   String   // role.id or user.id
  allow         Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([resource, resourceId, action, principalType, principalId])
  @@index([resource, action])
  @@index([principalType, principalId])
}

// Active user sessions. Tracks per-device login info so users can review
// and revoke other sessions from the profile page.
model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserSessions")
  tokenId      String   @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)

  @@index([userId])
  @@index([expiresAt])
}

// User-to-user direct messaging.
// Conversation has 2+ participants and many messages.
model Conversation {
  id            String   @id @default(cuid())
  title         String?  // optional, usually omitted for 1:1 chats
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime?

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ConversationMember")
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade, name: "MessageAuthor")
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([authorId])
}

// Per-user notification preferences. Each row represents one user's
// choice for one event type + channel. Missing rows default to enabled.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserNotifPrefs")
  eventType String
  channel   String   // "email" | "inapp"
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([userId, eventType, channel])
}

// Email broadcast - admin sends a single message to many users.
// Status: draft → queued → sending → sent (or failed)
model EmailBroadcast {
  id            String   @id @default(cuid())
  subject       String
  body          String   @db.Text
  status        String   @default("draft") // draft|queued|sending|sent|failed
  filter        Json     @default("{}")    // { roleIds?, userIds?, all? }
  createdById   String?
  totalCount    Int      @default(0)
  sentCount     Int      @default(0)
  failedCount   Int      @default(0)
  lastError     String?
  scheduledFor  DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([createdById])
}

// Tracks per-cron-job last-run timestamps. The scheduler reads/writes
// this on every tick to decide which jobs are due.
model CronRun {
  jobKey      String   @id   // "<moduleId>:<jobId>" or "core:<jobId>"
  lastRunAt   DateTime
  lastStatus  String?  // "ok" | "error"
  lastError   String?
  lastRunMs   Int?
  nextRunAt   DateTime?

  @@index([nextRunAt])
}

// Tracks which per-module SQL migrations have been applied to the DB.
// Replaces the old `prisma db push` workflow with a forward-only
// versioned migration system.
model ModuleMigration {
  id            String   @id @default(cuid())
  moduleId      String
  migrationName String
  checksum      String
  appliedAt     DateTime @default(now())
  executionMs   Int?

  @@unique([moduleId, migrationName])
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String
  keyPrefix   String
  userId      String
  user        User     @relation("ApiKeys", fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([keyPrefix])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  // Deleting the acting user must NOT erase their audit trail - the row
  // stays with userId nulled out so compliance / forensic queries over
  // historical events still surface the entity, action, and metadata.
  userId    String?
  user      User?    @relation("ActivityLogs", fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
}

// IP allowlist / blocklist. Supports single IPv4 addresses and
// IPv4 CIDR ranges (e.g. "192.168.1.0/24"). Scope limits where the
// block applies: "all" = entire site, "admin" = only /{locale}/admin
// and admin APIs, "api" = only /api/* endpoints. Optional expiresAt
// makes the block temporary; null = permanent.
model IpBlock {
  id          String    @id @default(cuid())
  ip          String    @unique
  scope       String    @default("all")
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  // No @@index([ip]) - `@unique` already creates a B-tree on `ip`.
  @@index([scope])
  @@index([expiresAt])
}

// Outbound email queue. Synchronous SMTP calls would block request
// handling and fail silently on transient errors; instead most callers
// enqueue via queueEmail() and a core cron (processEmailQueue) drains
// the queue every 5 minutes with exponential backoff.
//
// status flow:  pending → sending → sent
//                       \→ pending (retry, attempts < 3)
//                       \→ failed  (attempts >= 3)
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  body        String
  html        String?
  status      String    @default("pending") // pending | sending | sent | failed
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([createdAt])
}

// One attempt at moving the install to another version of Blysis.
//
// The row is the audit trail: the intent file on the shared volume is what the
// updater reads and it holds one run at a time, while this answers "what has
// this install done, and did it work" months later.
model CoreUpdate {
  id          String    @id @default(cuid())
  fromVersion String
  toVersion   String
  tag         String
  requestedBy String?
  status      String    @default("requested")
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([startedAt])
}
