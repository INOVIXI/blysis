{
  "id": "mollie-gateway",
  "name": "Mollie Payment Gateway",
  "description": "Take iDEAL, Bancontact, SEPA and card payments through Mollie",
  "version": "1.3.2",
  "coreVersion": "^3.0.0",
  "secretSettings": [
    "mollie_api_key"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "Landmark",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "Mollie",
      "description": "Mollie API key.",
      "href": "/settings/mollie",
      "icon": "Landmark",
      "color": "text-indigo-500"
    }
  ],
  "menu": [
    {
      "label": "Mollie Settings",
      "path": "/settings/mollie",
      "icon": "Landmark",
      "group": "commerce",
      "section": "payments",
      "permission": "mollie-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/mollie",
      "component": "pages/admin/page.tsx",
      "permission": "mollie-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/mollie/webhook",
      "providerCallback": true,
      "handler": "api/webhook/route.ts",
      "method": "POST",
      "description": "Mollie webhook. Reads the payment back from Mollie and reports it through the payment contract."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    },
    {
      "hook": "payment.refunded",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "mollieGateway": {
        "adm_title": "Mollie Settings",
        "adm_subtitle": "Keys for taking payments through Mollie.",
        "adm_apiKey": "API Key",
        "adm_apiKeyDesc": "From your Mollie dashboard. Point the Mollie notification URL at /api/v1/mollie/webhook."
      },
      "admin": {
        "menu_mollie-gateway": "Mollie Gateway",
        "menu_mollie-gateway_mollie_settings": "Mollie Settings",
        "module_mollie-gateway_name": "Mollie Payment Gateway",
        "module_mollie-gateway_description": "Take iDEAL, Bancontact, SEPA and card payments through Mollie"
      }
    },
    "tr": {
      "mollieGateway": {
        "adm_title": "Mollie Ayarları",
        "adm_subtitle": "Mollie ile ödeme almak için gereken anahtarlar.",
        "adm_apiKey": "API Anahtarı",
        "adm_apiKeyDesc": "Mollie panelinden alınır. Mollie bildirim adresini /api/v1/mollie/webhook olarak ayarlayın."
      },
      "admin": {
        "menu_mollie-gateway": "Mollie Ödeme",
        "menu_mollie-gateway_mollie_settings": "Mollie Ayarları",
        "module_mollie-gateway_name": "Mollie Ödeme Altyapısı",
        "module_mollie-gateway_description": "Mollie üzerinden iDEAL, Bancontact, SEPA ve kart ödemelerini alın"
      }
    }
  },
  "permissions": [
    "mollie-gateway.manage"
  ]
}
