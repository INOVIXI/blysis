// Custom Forms Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// ==================== CUSTOM FORMS ====================

model CustomForm {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  fields      Json
  isActive    Boolean  @default(true)
  // A form can be an application: only a signed-in member may send it, and
  // only `submissionLimit` times (null is no limit) since `limitPeriodStart`
  // (null is since the form was made). Resetting the allowances moves the
  // start; the submissions before it stay, they just stop counting.
  requireSignIn    Boolean   @default(false)
  submissionLimit  Int?
  limitPeriodStart DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions CustomFormSubmission[]
}

model CustomFormSubmission {
  id        String     @id @default(cuid())
  formId    String
  form      CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId    String?
  data      Json
  status    String     @default("new")
  // What the operator tells the person who sent it. The member reads it
  // beside the decision, so it is never a place for notes about them.
  reviewNote String?
  reviewedAt DateTime?
  createdAt DateTime   @default(now())

  // No User FK relation declared here - userId is a loose reference so the
  // form module stays decoupled from the User model (anonymous submissions
  // are valid). Stale userIds become harmless dangling pointers after the
  // user is deleted.
  @@index([formId])
  // The admin list is every submission, newest first, a page at a time,
  // with nothing narrowing it. Additive: formId is still its own lookup.
  @@index([createdAt])
  // A member's allowance is counted per form, and their own list is read
  // by who sent it.
  @@index([formId, userId, createdAt])
  @@index([userId, createdAt])
}
