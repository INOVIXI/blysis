{
  "id": "license-keys",
  "name": "License Keys",
  "description": "Generate, deliver and activate license keys for digital products, with a machine limit per key",
  "version": "1.4.2",
  "coreVersion": "^4.0.0",
  "category": "commerce",
  "author": "Blysis",
  "icon": "KeyRound",
  "dependencies": [
    "store"
  ],
  "adminRoutes": [
    {
      "path": "/licenses",
      "component": "pages/admin/licenses/page.tsx",
      "permission": "license-keys.manage"
    },
    {
      "path": "/settings/license-keys",
      "component": "pages/admin/settings/license-keys/page.tsx",
      "permission": "license-keys.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "License Keys",
      "description": "Which products hand out a key, and how many.",
      "href": "/settings/license-keys",
      "icon": "KeyRound",
      "color": "text-amber-500"
    }
  ],
  "api": [
    {
      "path": "/licenses",
      "handler": "api/licenses/route.ts",
      "method": "GET",
      "description": "The signed-in customer's own license keys."
    },
    {
      "path": "/licenses/activate",
      "handler": "api/licenses/activate/route.ts",
      "description": "Claim or release an activation seat for a machine.",
      "openTo": "public"
    },
    {
      "path": "/licenses/validate",
      "handler": "api/licenses/validate/route.ts",
      "description": "Check whether a key is valid, without claiming a seat.",
      "openTo": "public"
    },
    {
      "path": "/licenses/admin",
      "handler": "api/licenses/admin/route.ts",
      "description": "List every issued key, or mint new ones by hand (admin).",
      "permission": "license-keys.manage"
    },
    {
      "path": "/licenses/admin/[id]",
      "handler": "api/licenses/admin/[id]/route.ts",
      "description": "Revoke, restore or delete a single key (admin).",
      "permission": "license-keys.manage"
    },
    {
      "path": "/licenses/products",
      "handler": "api/licenses/products/route.ts",
      "description": "List or add the products that hand out a key (admin).",
      "permission": "license-keys.manage"
    },
    {
      "path": "/licenses/products/[id]",
      "handler": "api/licenses/products/[id]/route.ts",
      "description": "Edit or remove one product mapping (admin).",
      "permission": "license-keys.manage"
    }
  ],
  "profileTabs": [
    {
      "id": "ProfileLicensesTab",
      "label": "Licenses",
      "component": "components/ProfileLicensesTab",
      "order": 45,
      "labelKey": "licenseKeys.profileTab"
    }
  ],
  "hookListeners": [
    {
      "hook": "store.order.completed",
      "type": "action",
      "handler": "hooks/on-order-completed.ts"
    }
  ],
