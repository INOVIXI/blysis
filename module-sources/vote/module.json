  "userDataExport": [
    {
      "model": "voteLog",
      "key": "vote.logs",
      "column": "userId",
      "erasure": "retain"
    }
  ],
  "navLinks": [
    {
      "label": "Vote",
      "labelKey": "vote",
      "href": "/vote",
