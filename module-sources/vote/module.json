{
  "id": "vote",
  "name": "Vote Sites",
  "description": "Send players to the server listings you are ranked on, and count who voted",
  "version": "1.6.2",
  "coreVersion": "^4.0.0",
  "category": "gaming",
  "author": "Blysis",
  "icon": "Vote",
  "permissions": [
    {
      "name": "vote.manage",
      "labelKey": "vote.perm_manage"
    }
  ],
  "menu": [
    {
      "label": "Vote Sites",
      "path": "/vote-sites",
      "icon": "Vote",
      "group": "gaming",
      "permission": "vote.manage"
    }
  ],
  "routes": [
    {
      "path": "/vote",
      "component": "pages/public/page.tsx",
      "titleKey": "pageTitles.vote",
      "descriptionKey": "pageDescriptions.vote"
    }
  ],
  "adminRoutes": [
    {
      "path": "/vote-sites",
      "component": "pages/admin/sites/page.tsx",
      "permission": "vote.manage"
    }
  ],
  "api": [
    {
      "path": "/vote/sites",
      "handler": "api/sites/route.ts",
      "description": "List vote sites and create new ones (admin).",
      "permission": "vote.manage"
    },
    {
      "path": "/vote/sites/[id]",
      "handler": "api/sites/[id]/route.ts",
      "description": "Update or delete a vote site (admin).",
      "permission": "vote.manage"
    },
    {
      "path": "/vote/record",
      "handler": "api/record/route.ts",
      "description": "Record that the signed-in user voted on an external site.",
      "rateLimit": {
        "maxRequests": 30,
        "windowMs": 60000
      },
      "openTo": "member"
    }
  ],
  "dependencies": [],
  "hooksEmitted": [
    {
      "hook": "vote.vote.cast",
      "type": "action"
    }
  ],
  "translations": {
