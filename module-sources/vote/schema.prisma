// Vote Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// @@user-relations-start
//   votes            VoteLog[]
// @@user-relations-end

// ==================== VOTE ====================

model VoteSite {
  id        String    @id @default(cuid())
  name      String
  url       String
  icon      String?
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  votes     VoteLog[]
}

/// One click through to a listing site, not one vote.
///
/// Nothing here hears back from the listing. The button opens it and this row
/// is written because a member went, which is the only part this site can see.
/// Everything built on it counts the same thing: the cooldown, the ranking and
/// the trophy are all about going, and the screens say so.
///
/// The name predates the distinction and a rename is a migration that reaches
/// the leaderboard and the trophy engine, so it is written down here instead.
model VoteLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteSiteId String
  voteSite   VoteSite @relation(fields: [voteSiteId], references: [id])
  createdAt  DateTime @default(now())

  // No @@unique([userId, voteSiteId]) - the claim handler stores one row
  // per vote so the 24h cooldown can be derived from the latest createdAt.
  // That read is `where userId, voteSiteId order by createdAt desc limit 1`,
  // which this index answers whole, ordering included; leading with userId
  // also gives the cascade from User something to seek on.
  @@index([userId, voteSiteId, createdAt])
  @@index([voteSiteId])
  @@index([createdAt])
}
