{
  "id": "paytr-gateway",
  "name": "PayTR Payment Gateway",
  "description": "Take Turkish card, instalment and bank transfer payments through PayTR",
  "version": "1.3.2",
  "coreVersion": "^4.0.0",
  "secretSettings": [
    "paytr_merchant_key",
    "paytr_merchant_salt"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "CreditCard",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "PayTR",
      "description": "PayTR merchant credentials and mode.",
      "href": "/settings/paytr",
      "icon": "CreditCard",
      "color": "text-orange-500"
    }
  ],
  "menu": [
    {
      "label": "PayTR Settings",
      "path": "/settings/paytr",
      "icon": "CreditCard",
      "group": "commerce",
      "section": "payments",
      "permission": "paytr-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/paytr",
      "component": "pages/admin/page.tsx",
      "permission": "paytr-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/paytr/callback",
      "providerCallback": true,
      "handler": "api/callback/route.ts",
      "method": "POST",
      "description": "PayTR payment notification. Verifies the hash and reports the payment through the payment contract."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "paytrGateway": {
        "adm_merchantId": "Merchant ID",
        "adm_merchantIdDesc": "From your PayTR dashboard.",
        "adm_merchantKey": "Merchant Key",
        "adm_merchantKeyDesc": "From your PayTR dashboard.",
        "adm_merchantSalt": "Merchant Salt",
        "adm_merchantSaltDesc": "From your PayTR dashboard. Point the PayTR notification URL at /api/v1/paytr/callback.",
        "adm_sandbox": "Sandbox Mode",
        "adm_sandboxDesc": "Set to true to use the PayTR test environment.",
        "adm_subtitle": "Keys for taking payments through PayTR.",
        "adm_title": "PayTR Settings",
        "perm_manage": "Manage"
      },
      "admin": {
        "menu_paytr-gateway": "PayTR Gateway",
        "menu_paytr-gateway_paytr_settings": "PayTR Settings",
        "module_paytr-gateway_name": "PayTR Payment Gateway",
        "module_paytr-gateway_description": "Take Turkish card, instalment and bank transfer payments through PayTR"
      }
    },
    "tr": {
      "paytrGateway": {
        "adm_merchantId": "Üye İşyeri Numarası",
        "adm_merchantIdDesc": "PayTR panelinden alınır.",
        "adm_merchantKey": "Üye İşyeri Anahtarı",
        "adm_merchantKeyDesc": "PayTR panelinden alınır.",
        "adm_merchantSalt": "Üye İşyeri Salt Değeri",
        "adm_merchantSaltDesc": "PayTR panelinden alınır. PayTR bildirim adresini /api/v1/paytr/callback olarak ayarlayın.",
        "adm_sandbox": "Test Ortamı",
        "adm_sandboxDesc": "PayTR test ortamı için true yazın.",
        "adm_subtitle": "PayTR ile ödeme almak için gereken anahtarlar.",
        "adm_title": "PayTR Ayarları",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "menu_paytr-gateway": "PayTR Ödeme",
        "menu_paytr-gateway_paytr_settings": "PayTR Ayarları",
        "module_paytr-gateway_name": "PayTR Ödeme Altyapısı",
        "module_paytr-gateway_description": "PayTR üzerinden Türk kartı, taksit ve havale ödemelerini alın"
      }
    }
  },
  "permissions": [
    {
      "name": "paytr-gateway.manage",
      "labelKey": "paytrGateway.perm_manage"
    }
  ]
}
