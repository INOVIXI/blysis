{
  "id": "coinpayments-gateway",
  "name": "CoinPayments Gateway",
  "description": "Take Bitcoin, Litecoin, USDT and other crypto payments through CoinPayments",
  "version": "1.3.2",
  "coreVersion": "^5.0.0",
  "secretSettings": [
    "coinpayments_ipn_secret"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "Bitcoin",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "CoinPayments",
      "description": "CoinPayments merchant id and IPN secret.",
      "href": "/settings/coinpayments",
      "icon": "Bitcoin",
      "color": "text-amber-500"
    }
  ],
  "menu": [
    {
      "label": "CoinPayments Settings",
      "path": "/settings/coinpayments",
      "icon": "Bitcoin",
      "group": "commerce",
      "section": "payments",
      "permission": "coinpayments-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/coinpayments",
      "component": "pages/admin/page.tsx",
      "permission": "coinpayments-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/coinpayments/ipn",
      "providerCallback": true,
      "handler": "api/ipn/route.ts",
      "method": "POST",
      "description": "CoinPayments IPN. Verifies the HMAC and settles a payment once the coins have arrived."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "coinpaymentsGateway": {
        "adm_ipnSecret": "IPN Secret",
        "adm_ipnSecretDesc": "From your CoinPayments dashboard. Point the CoinPayments notification URL at /api/v1/coinpayments/ipn.",
        "adm_merchantId": "Merchant ID",
        "adm_merchantIdDesc": "From your CoinPayments dashboard.",
        "adm_subtitle": "Keys for taking payments through CoinPayments.",
        "adm_title": "CoinPayments Settings",
        "perm_manage": "Manage"
      },
      "admin": {
        "menu_coinpayments-gateway": "CoinPayments Gateway",
        "menu_coinpayments-gateway_coinpayments_settings": "CoinPayments Settings",
        "module_coinpayments-gateway_name": "CoinPayments Gateway",
        "module_coinpayments-gateway_description": "Take Bitcoin, Litecoin, USDT and other crypto payments through CoinPayments"
      }
    },
    "tr": {
      "coinpaymentsGateway": {
        "adm_ipnSecret": "IPN Gizli Anahtarı",
        "adm_ipnSecretDesc": "CoinPayments panelinden alınır. CoinPayments bildirim adresini /api/v1/coinpayments/ipn olarak ayarlayın.",
        "adm_merchantId": "Üye İşyeri Numarası",
        "adm_merchantIdDesc": "CoinPayments panelinden alınır.",
        "adm_subtitle": "CoinPayments ile ödeme almak için gereken anahtarlar.",
        "adm_title": "CoinPayments Ayarları",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "menu_coinpayments-gateway": "CoinPayments Ödeme",
        "menu_coinpayments-gateway_coinpayments_settings": "CoinPayments Ayarları",
        "module_coinpayments-gateway_name": "CoinPayments Altyapısı",
        "module_coinpayments-gateway_description": "CoinPayments üzerinden Bitcoin, Litecoin, USDT ve diğer kripto ödemelerini alın"
      }
    }
  },
  "permissions": [
    {
      "name": "coinpayments-gateway.manage",
      "labelKey": "coinpaymentsGateway.perm_manage"
    }
  ]
}
