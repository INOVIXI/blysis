{
  "id": "midtrans-gateway",
  "name": "Midtrans Gateway",
  "description": "Take bank transfer, e-wallet, convenience store and card payments in Indonesia through Midtrans",
  "version": "1.4.0",
  "coreVersion": "^5.0.0",
  "secretSettings": [
    "midtrans_server_key"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "Smartphone",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "Midtrans",
      "description": "Midtrans server key and environment.",
      "href": "/settings/midtrans",
      "icon": "Smartphone",
      "color": "text-teal-500"
    }
  ],
  "menu": [
    {
      "label": "Midtrans Settings",
      "path": "/settings/midtrans",
      "icon": "Smartphone",
      "group": "commerce",
      "section": "payments",
      "permission": "midtrans-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/midtrans",
      "component": "pages/admin/page.tsx",
      "permission": "midtrans-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/midtrans/notify",
      "providerCallback": true,
      "handler": "api/notify/route.ts",
      "method": "POST",
      "description": "Midtrans payment notification. Verifies the signature and reports the payment through the payment contract."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    },
    {
      "hook": "payment.refunded",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "midtransGateway": {
        "adm_sandbox": "Sandbox Mode",
        "adm_sandboxDesc": "Set to true to use the Midtrans test environment.",
        "adm_serverKey": "Server Key",
        "adm_serverKeyDesc": "From your Midtrans dashboard. Point the Midtrans notification URL at /api/v1/midtrans/notify.",
        "adm_subtitle": "Keys for taking payments through Midtrans.",
        "adm_title": "Midtrans Settings",
        "perm_manage": "Manage"
      },
      "admin": {
        "menu_midtrans-gateway": "Midtrans Gateway",
        "menu_midtrans-gateway_midtrans_settings": "Midtrans Settings",
        "module_midtrans-gateway_name": "Midtrans Gateway",
        "module_midtrans-gateway_description": "Take bank transfer, e-wallet, convenience store and card payments in Indonesia through Midtrans",
        "settings_midtrans-gateway": "Midtrans",
        "settings_midtrans-gateway_description": "Midtrans server key and environment."
      }
    },
    "tr": {
      "midtransGateway": {
        "adm_sandbox": "Test Ortamı",
        "adm_sandboxDesc": "Midtrans test ortamı için true yazın.",
        "adm_serverKey": "Sunucu Anahtarı",
        "adm_serverKeyDesc": "Midtrans panelinden alınır. Midtrans bildirim adresini /api/v1/midtrans/notify olarak ayarlayın.",
        "adm_subtitle": "Midtrans ile ödeme almak için gereken anahtarlar.",
        "adm_title": "Midtrans Ayarları",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "menu_midtrans-gateway": "Midtrans Ödeme",
        "menu_midtrans-gateway_midtrans_settings": "Midtrans Ayarları",
        "module_midtrans-gateway_name": "Midtrans Altyapısı",
        "module_midtrans-gateway_description": "Midtrans üzerinden Endonezya'da havale, e-cüzdan, market ve kart ödemelerini alın",
        "settings_midtrans-gateway": "Midtrans",
        "settings_midtrans-gateway_description": "Midtrans sunucu anahtarı ve ortamı."
      }
    }
  },
  "permissions": [
    {
      "name": "midtrans-gateway.manage",
      "labelKey": "midtransGateway.perm_manage"
    }
  ]
}
