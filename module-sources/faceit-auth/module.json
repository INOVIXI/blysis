{
  "id": "faceit-auth",
  "name": "FACEIT Login",
  "description": "Allow users to sign in with their FACEIT account",
  "version": "1.2.2",
  "coreVersion": "^5.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "Swords",
  "adminRoutes": [
    {
      "path": "/settings/faceit-auth",
      "component": "pages/admin/settings/faceit-auth/page.tsx",
      "permission": "faceit-auth.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "FACEIT OAuth",
      "description": "FACEIT application credentials.",
      "href": "/settings/faceit-auth",
      "icon": "Swords",
      "color": "text-orange-500"
    }
  ],
  "authProviders": [
    {
      "id": "faceit",
      "envIdVar": "AUTH_FACEIT_ID",
      "envSecretVar": "AUTH_FACEIT_SECRET"
    }
  ],
  "oauthButtons": [
    {
      "id": "faceit-login",
      "provider": "faceit",
      "label": "FACEIT",
      "color": "#FF5500",
      "svgIcon": "M23.999 2.705a.167.167 0 00-.312-.1 1141.27 1141.27 0 00-6.053 9.375H.218c-.221 0-.301.282-.11.352 7.227 2.73 17.667 6.836 23.5 9.134.15.06.39-.08.39-.18z"
    }
  ],
  "translations": {
