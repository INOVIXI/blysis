        "adm_subtitle": "Configure FACEIT OAuth2 login for your site",
        "adm_title": "FACEIT Auth Settings",
        "clientId": "Client ID",
        "clientSecret": "Client Secret",
        "description": "Configure FACEIT OAuth credentials for user login",
        "disabled": "FACEIT Login Disabled",
        "enable": "Enable FACEIT Login",
        "enabled": "FACEIT Login Enabled",
        "linkAccount": "Link FACEIT Account",
        "perm_manage": "Manage",
        "save": "Save Settings",
        "saveError": "Failed to save FACEIT OAuth settings",
        "saved": "FACEIT OAuth settings saved successfully",
        "settings": "FACEIT OAuth Settings",
        "title": "FACEIT Login"
      },
      "admin": {
        "title": "Admin Panel",
        "subtitle": "Manage your platform settings and content",
        "module_faceit-auth_name": "FACEIT Login",
        "module_faceit-auth_description": "Allow users to sign in with their FACEIT account"
      }
    },
    "tr": {
      "faceitAuth": {
        "adm_subtitle": "Siteniz için FACEIT OAuth2 girişini yapılandırın",
