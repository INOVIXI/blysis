{
  "id": "nowpayments-gateway",
  "name": "NOWPayments Gateway",
  "description": "Take payments in 200+ cryptocurrencies through NOWPayments",
  "version": "1.3.2",
  "coreVersion": "^4.0.0",
  "secretSettings": [
    "nowpayments_api_key",
    "nowpayments_ipn_secret"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "Bitcoin",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "NOWPayments",
      "description": "NOWPayments API key and IPN secret.",
      "href": "/settings/nowpayments",
      "icon": "Bitcoin",
      "color": "text-cyan-500"
    }
  ],
  "menu": [
    {
      "label": "NOWPayments Settings",
      "path": "/settings/nowpayments",
      "icon": "Bitcoin",
      "group": "commerce",
      "section": "payments",
      "permission": "nowpayments-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/nowpayments",
      "component": "pages/admin/page.tsx",
      "permission": "nowpayments-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/nowpayments/ipn",
      "providerCallback": true,
      "handler": "api/ipn/route.ts",
      "method": "POST",
      "description": "NOWPayments IPN. Verifies the signature and settles a payment once it is final."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    },
    {
      "hook": "payment.refunded",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "nowpaymentsGateway": {
        "adm_apiKey": "API Key",
        "adm_apiKeyDesc": "From your NOWPayments dashboard.",
        "adm_ipnSecret": "IPN Secret",
        "adm_ipnSecretDesc": "From your NOWPayments dashboard. Point the NOWPayments notification URL at /api/v1/nowpayments/ipn.",
        "adm_subtitle": "Keys for taking payments through NOWPayments.",
        "adm_title": "NOWPayments Settings",
        "perm_manage": "Manage"
      },
      "admin": {
        "menu_nowpayments-gateway": "NOWPayments Gateway",
        "menu_nowpayments-gateway_nowpayments_settings": "NOWPayments Settings",
        "module_nowpayments-gateway_name": "NOWPayments Gateway",
        "module_nowpayments-gateway_description": "Take payments in 200+ cryptocurrencies through NOWPayments"
      }
    },
    "tr": {
      "nowpaymentsGateway": {
        "adm_apiKey": "API Anahtarı",
        "adm_apiKeyDesc": "NOWPayments panelinden alınır.",
        "adm_ipnSecret": "IPN Gizli Anahtarı",
        "adm_ipnSecretDesc": "NOWPayments panelinden alınır. NOWPayments bildirim adresini /api/v1/nowpayments/ipn olarak ayarlayın.",
        "adm_subtitle": "NOWPayments ile ödeme almak için gereken anahtarlar.",
        "adm_title": "NOWPayments Ayarları",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "menu_nowpayments-gateway": "NOWPayments Ödeme",
        "menu_nowpayments-gateway_nowpayments_settings": "NOWPayments Ayarları",
        "module_nowpayments-gateway_name": "NOWPayments Altyapısı",
        "module_nowpayments-gateway_description": "NOWPayments üzerinden 200'den fazla kripto para ile ödeme alın"
      }
    }
  },
  "permissions": [
    {
      "name": "nowpayments-gateway.manage",
      "labelKey": "nowpaymentsGateway.perm_manage"
    }
  ]
}
