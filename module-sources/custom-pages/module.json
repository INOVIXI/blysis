{
  "id": "custom-pages",
  "name": "Custom Pages",
  "description": "Admin-created HTML content pages",
  "version": "1.3.2",
  "coreVersion": "^4.0.0",
  "category": "content",
  "author": "Blysis",
  "icon": "FileText",
  "routes": [
    {
      "path": "/page/[slug]",
      "component": "pages/public/[slug]/page.tsx",
      "resolver": "lib/route-exists.ts",
      "titleKey": "pageTitles.page",
      "descriptionKey": "pageDescriptions.page"
    }
  ],
  "adminRoutes": [
    {
      "path": "/custom-pages",
      "component": "pages/admin/page.tsx",
      "permission": "custom-pages.manage"
    },
    {
      "path": "/custom-pages/builder/[id]",
      "component": "pages/admin/builder/[id]/page.tsx",
      "permission": "custom-pages.manage"
    }
  ],
  "menu": [
    {
      "label": "Custom Pages",
      "path": "/custom-pages",
      "icon": "FileText",
      "group": "content",
      "section": "publishing",
      "permission": "custom-pages.manage"
    }
  ],
  "api": [
    {
      "path": "/custom-pages",
      "handler": "api/route.ts",
      "description": "List custom pages and create new ones (admin).",
      "permission": "custom-pages.manage"
    },
    {
      "path": "/custom-pages/[slug]",
      "handler": "api/[slug]/route.ts",
      "description": "Get, update, or delete a single custom page by slug.",
      "permission": "custom-pages.manage"
    }
  ],
