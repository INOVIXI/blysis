  "pageBlocks": [
    {
      "id": "BlogLatestPosts",
      "category": "Blog",
      "component": "blocks/BlogLatestPosts.tsx"
    },
    {
      "id": "BlogCategoryGrid",
      "category": "Blog",
      "component": "blocks/BlogCategoryGrid.tsx"
    }
  ],
  "searchProviders": [
    {
      "id": "blog-search",
      "label": "Blog",
      "handler": "search/handler.ts",
      "icon": "FileText",
      "indexes": [
        {
          "table": "BlogArticle",
          "columns": [
            "title",
            "excerpt",
            "content"
          ]
        }
      ]
    }
  ],
  "seoRoutes": {
    "handler": "seo/sitemap.ts"
  },
  "userDataExport": [
    {
      "model": "blogArticle",
      "key": "blog.articles",
      "column": "authorId",
      "erasure": "retain"
    },
    {
      "model": "blogComment",
      "key": "blog.comments",
      "column": "authorId",
      "erasure": "retain"
    }
  ],
  "moderationProviders": [
    {
      "id": "blog-comment",
      "label": "Blog comments",
      "labelKey": "moderation_blogComment",
      "settingKey": "blog_comments",
      "settingLabelKey": "moderationSettings_blogComments",
      "settingDescKey": "moderationSettings_blogCommentsDesc",
      "handler": "moderation/comments.ts"
    }
  ],
  "cronJobs": [
    {
      "id": "publish-scheduled",
      "schedule": "every-5-minutes",
      "handler": "cron/publish-scheduled.ts"
    }
  ],
  "hookListeners": [
    {
      "hook": "blog.article.created",
      "type": "action",
      "handler": "hooks/on-article-created.ts"
    }
  ],
  "navLinks": [
    {
      "label": "Blog",
      "labelKey": "blog",
      "href": "/blog",
      "icon": "Newspaper",
      "position": 10
    }
  ],
  "footerLinks": [
    {
      "label": "Blog",
      "labelKey": "blog",
      "href": "/blog",
      "section": "quick"
    }
  ],
  "activityTitles": [
    {
      "type": "blog.article.created",
      "prefix": "Published: ",
      "key": "blogArticlePublished"
    }
  ],
  "permissionResources": [
    "blog.article",
    "blog.category"
  ]
}
