{
  "id": "razorpay-gateway",
  "name": "Razorpay Gateway",
  "description": "Take UPI, card, netbanking and wallet payments in India through Razorpay",
  "version": "1.3.2",
  "coreVersion": "^3.0.0",
  "secretSettings": [
    "razorpay_key_secret",
    "razorpay_webhook_secret"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "Smartphone",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "Razorpay",
      "description": "Razorpay API keys and webhook secret.",
      "href": "/settings/razorpay",
      "icon": "Smartphone",
      "color": "text-blue-600"
    }
  ],
  "menu": [
    {
      "label": "Razorpay Settings",
      "path": "/settings/razorpay",
      "icon": "Smartphone",
      "group": "commerce",
      "section": "payments"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/razorpay",
      "component": "pages/admin/page.tsx"
    }
  ],
  "api": [
    {
      "path": "/razorpay/webhook",
      "providerCallback": true,
      "handler": "api/webhook/route.ts",
      "method": "POST",
      "description": "Razorpay webhook. Verifies the signature and reports payments through the payment contract."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    },
    {
      "hook": "payment.refunded",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "razorpayGateway": {
        "adm_title": "Razorpay Settings",
        "adm_subtitle": "Keys for taking payments through Razorpay.",
        "adm_keyId": "Key ID",
        "adm_keyIdDesc": "From your Razorpay dashboard.",
        "adm_keySecret": "Key Secret",
        "adm_keySecretDesc": "From your Razorpay dashboard.",
        "adm_webhookSecret": "Webhook Secret",
        "adm_webhookSecretDesc": "From your Razorpay dashboard. Point the Razorpay notification URL at /api/v1/razorpay/webhook."
      },
      "admin": {
        "menu_razorpay-gateway": "Razorpay Gateway",
        "menu_razorpay-gateway_razorpay_settings": "Razorpay Settings",
        "module_razorpay-gateway_name": "Razorpay Gateway",
        "module_razorpay-gateway_description": "Take UPI, card, netbanking and wallet payments in India through Razorpay"
      }
    },
    "tr": {
      "razorpayGateway": {
        "adm_title": "Razorpay Ayarları",
        "adm_subtitle": "Razorpay ile ödeme almak için gereken anahtarlar.",
        "adm_keyId": "Anahtar Kimliği",
        "adm_keyIdDesc": "Razorpay panelinden alınır.",
        "adm_keySecret": "Gizli Anahtar",
        "adm_keySecretDesc": "Razorpay panelinden alınır.",
        "adm_webhookSecret": "Webhook Gizli Anahtarı",
        "adm_webhookSecretDesc": "Razorpay panelinden alınır. Razorpay bildirim adresini /api/v1/razorpay/webhook olarak ayarlayın."
      },
      "admin": {
        "menu_razorpay-gateway": "Razorpay Ödeme",
        "menu_razorpay-gateway_razorpay_settings": "Razorpay Ayarları",
        "module_razorpay-gateway_name": "Razorpay Altyapısı",
        "module_razorpay-gateway_description": "Razorpay üzerinden Hindistan'da UPI, kart, internet bankacılığı ve cüzdan ödemelerini alın"
      }
    }
  }
}
