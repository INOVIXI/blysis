// Comparison Table Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

/// One table comparing several things against a list of features.
///
/// Nothing here knows what is being compared: plans, ranks, packages, tools.
/// A column may link somewhere, and that is the only relationship it has to
/// the rest of the site.
model ComparisonTable {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  /**
   * What this table is about, when it is about something the site already
   * has: `store.category:<id>`, and whatever another module mints later.
   *
   * With one, the columns are not typed by an operator - they are the things
   * inside the subject, asked for through `comparison.columns`, so a table of
   * a shop category has the category's own products in it with their live
   * prices and a way to buy each one. Without one, the table is a standalone
   * comparison of whatever somebody typed, which is what every table was
   * before and what a site with no shop still wants.
   *
   * Unique: two tables about one subject is two answers to the same question.
   */
  subjectRef  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  columns ComparisonColumn[]
  groups  ComparisonGroup[]
  rows    ComparisonRow[]

  @@index([isActive, order])
}

/// One thing being compared. A column of the table.
model ComparisonColumn {
  id       String @id @default(cuid())
  tableId  String
  table    ComparisonTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  label    String
  subtitle String?
  /// Where the reader goes to get it. Any URL, so this module never learns
  /// what is on the other end.
  href     String?
  /// The one an operator wants the eye to land on.
  highlight Boolean @default(false)
  order    Int     @default(0)
  /**
   * The thing this column is, when the table has a subject.
   *
   * Opaque here. It is how the operator's cells stay attached to the right
   * product while everything visible about that product - its name, its
   * price, its picture - comes from whoever owns it at the moment the page is
   * drawn. `label` is kept as the fallback for the day that module is
   * uninstalled: the table then reads the way it did before, rather than
   * losing a column and every cell in it.
   *
   * A column whose source has gone is kept and not drawn. Deleting it would
   * take an operator's answers with it, and a product moved out of a category
   * this week is often back in it next week.
   */
  sourceRef String?

  cells ComparisonCell[]

  @@index([tableId, order])
  @@unique([tableId, sourceRef])
}

/// A heading over a run of rows.
model ComparisonGroup {
  id      String @id @default(cuid())
  tableId String
  table   ComparisonTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  label   String
  order   Int    @default(0)

  /// A deleted group leaves its rows behind on purpose: dropping them would
  /// quietly remove a feature from a comparison somebody is reading.
  rows ComparisonRow[]

  @@index([tableId, order])
}

/// One feature, compared across every column.
model ComparisonRow {
  id      String @id @default(cuid())
  tableId String
  table   ComparisonTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  groupId String?
  group   ComparisonGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  label   String
  order   Int    @default(0)

  cells ComparisonCell[]

  @@index([tableId, order])
  @@index([groupId])
}

/// What one column says about one feature.
///
/// A row with no cell for a column is unstated, which is not the same as "no".
/// There is deliberately no row meaning "unstated": it is the absence.
model ComparisonCell {
  id       String @id @default(cuid())
  rowId    String
  row      ComparisonRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  columnId String
  column   ComparisonColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  /// yes | no | value
  kind     String
  value    String?

  @@unique([rowId, columnId])
  @@index([columnId])
}
