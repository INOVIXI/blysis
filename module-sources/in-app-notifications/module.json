  },
  "userDataExport": [
    {
      "model": "notification",
      "key": "notifications.items",
      "column": "userId",
      "erasure": "purge"
    }
  ],
  "hookListeners": [
    {
      "hook": "store.order.completed",
      "type": "action",
      "handler": "listeners/order-completed.ts"
    },
    {
      "hook": "credits.credit.added",
      "type": "action",
      "handler": "listeners/credit-added.ts"
    },
    {
      "hook": "punishments.punishment.issued",
      "type": "action",
      "handler": "listeners/punishment-issued.ts"
    },
    {
      "hook": "wheel.prize.won",
      "type": "action",
      "handler": "listeners/prize-won.ts"
    },
    {
      "hook": "referral.referral.used",
      "type": "action",
      "handler": "listeners/referral-used.ts"
    },
    {
      "hook": "tickets.ticket.replied",
      "type": "action",
      "handler": "listeners/ticket-replied.ts"
    },
    {
      "hook": "forum.post.created",
      "type": "action",
      "handler": "listeners/forum-post-created.ts"
    }
  ]
}
