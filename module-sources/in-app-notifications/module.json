        "notif_orderCompleteMessage": "Order {orderNumber} is complete.",
        "notif_creditsAddedTitle": "Credits added",
        "notif_creditsAddedMessage": "{amount} credits were added to your balance.",
        "notif_punishmentTitle": "A punishment was issued",
        "notif_punishmentMessage": "A {type} was issued against your account.",
        "notif_punishmentWithReason": "{type}: {reason}",
        "notif_prizeWonTitle": "You won a prize",
        "notif_prizeWonMessage": "You won {prize} on the wheel.",
        "notif_referralUsedTitle": "Your referral code was used",
        "notif_referralUsedMessage": "Somebody joined with your referral code.",
