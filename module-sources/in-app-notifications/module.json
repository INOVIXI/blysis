{
  "id": "in-app-notifications",
  "name": "In-App Notifications",
  "description": "In-app notification system with bell icon",
  "version": "1.6.0",
  "coreVersion": "^5.0.0",
  "category": "community",
  "author": "Blysis",
  "icon": "Bell",
  "navbarComponents": [
    {
      "id": "NotificationBell",
      "component": "components/NotificationBell",
      "order": 10
    }
  ],
  "routes": [
    {
      "path": "/notifications",
      "component": "pages/public/notifications/page.tsx",
      "titleKey": "pageTitles.notifications",
      "descriptionKey": "pageDescriptions.notifications"
    }
  ],
  "api": [
    {
      "path": "/notifications",
      "handler": "api/route.ts",
      "description": "Get user notifications and mark them read.",
      "openTo": "member"
    }
  ],
  "translations": {
    "en": {
