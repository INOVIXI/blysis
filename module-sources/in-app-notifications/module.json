      "pageTitles": {
        "notifications": "Notifications"
      },
      "admin": {
        "module_in-app-notifications_name": "In-App Notifications",
        "module_in-app-notifications_description": "In-app notification system with bell icon"
      },
      "pageDescriptions": {
        "notifications": "See every notification you have been sent, mark them as read and open the page each one points to."
      }
    },
    "tr": {
      "inAppNotifications": {
        "title": "Bildirimler",
