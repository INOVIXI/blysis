{
  "id": "currency",
  "name": "Multi-Currency",
  "description": "Multi-currency support with automatic conversion",
  "version": "1.6.2",
  "coreVersion": "^5.0.0",
  "category": "commerce",
  "author": "Blysis",
  "icon": "DollarSign",
  "menu": [
    {
      "label": "Currency",
      "path": "/currency",
      "icon": "DollarSign",
      "group": "commerce",
      "permission": "currency.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/currency",
      "component": "pages/admin/page.tsx",
      "permission": "currency.manage"
    }
  ],
  "api": [
    {
      "path": "/currency",
      "handler": "api/route.ts",
      "description": "List available currencies and create new ones (admin).",
      "permission": "currency.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "Currency Settings",
      "description": "Manage currencies and exchange rates",
      "href": "/currency",
      "icon": "DollarSign",
      "color": "text-green-500"
    }
  ],
  "footerComponents": [
    {
      "id": "CurrencySelector",
      "component": "components/CurrencySelector",
      "order": 10
    }
  ],
  "cronJobs": [
    {
      "id": "currency-rate-refresh",
      "schedule": "every-hour",
      "handler": "cron/refresh.ts"
    }
  ],
