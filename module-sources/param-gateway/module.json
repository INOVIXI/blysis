{
  "id": "param-gateway",
  "name": "Param Payment Gateway",
  "description": "Take Turkish card and instalment payments through Param (TurkPos)",
  "version": "1.4.0",
  "coreVersion": "^5.0.0",
  "secretSettings": [
    "param_client_password",
    "param_guid"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "CreditCard",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "Param",
      "description": "Param terminal credentials and mode.",
      "href": "/settings/param",
      "icon": "CreditCard",
      "color": "text-sky-500"
    }
  ],
  "menu": [
    {
      "label": "Param Settings",
      "path": "/settings/param",
      "icon": "CreditCard",
      "group": "commerce",
      "section": "payments",
      "permission": "param-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/param",
      "component": "pages/admin/page.tsx",
      "permission": "param-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/param/callback",
      "providerCallback": true,
      "handler": "api/callback/route.ts",
      "method": "POST",
      "description": "Where Param posts the result of a payment. Reads the payment back from Param before settling it."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
