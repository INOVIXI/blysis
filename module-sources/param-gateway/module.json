{
  "id": "param-gateway",
  "name": "Param Payment Gateway",
  "description": "Take Turkish card and instalment payments through Param (TurkPos)",
  "version": "1.3.2",
  "coreVersion": "^5.0.0",
  "secretSettings": [
    "param_client_password",
    "param_guid"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "CreditCard",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "Param",
      "description": "Param terminal credentials and mode.",
      "href": "/settings/param",
      "icon": "CreditCard",
      "color": "text-sky-500"
    }
  ],
  "menu": [
    {
      "label": "Param Settings",
      "path": "/settings/param",
      "icon": "CreditCard",
      "group": "commerce",
      "section": "payments",
      "permission": "param-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/param",
      "component": "pages/admin/page.tsx",
      "permission": "param-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/param/callback",
      "providerCallback": true,
      "handler": "api/callback/route.ts",
      "method": "POST",
      "description": "Where Param posts the result of a payment. Reads the payment back from Param before settling it."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "paramGateway": {
        "adm_clientCode": "Client Code",
        "adm_clientCodeDesc": "From your Param dashboard.",
        "adm_clientPass": "Client Password",
        "adm_clientPassDesc": "From your Param dashboard.",
        "adm_clientUser": "Client Username",
        "adm_clientUserDesc": "From your Param dashboard.",
        "adm_guid": "Terminal GUID",
        "adm_guidDesc": "From your Param dashboard.",
        "adm_sandbox": "Sandbox Mode",
        "adm_sandboxDesc": "Set to true to use the Param test environment.",
        "adm_subtitle": "Keys for taking payments through Param.",
        "adm_title": "Param Settings",
        "perm_manage": "Manage"
      },
      "admin": {
        "menu_param-gateway": "Param Gateway",
        "menu_param-gateway_param_settings": "Param Settings",
        "module_param-gateway_name": "Param Payment Gateway",
        "module_param-gateway_description": "Take Turkish card and instalment payments through Param (TurkPos)"
      }
    },
    "tr": {
      "paramGateway": {
        "adm_clientCode": "Müşteri Kodu",
        "adm_clientCodeDesc": "Param panelinden alınır.",
        "adm_clientPass": "Müşteri Şifresi",
        "adm_clientPassDesc": "Param panelinden alınır.",
        "adm_clientUser": "Müşteri Kullanıcı Adı",
        "adm_clientUserDesc": "Param panelinden alınır.",
        "adm_guid": "Terminal GUID",
        "adm_guidDesc": "Param panelinden alınır.",
        "adm_sandbox": "Test Ortamı",
        "adm_sandboxDesc": "Param test ortamı için true yazın.",
        "adm_subtitle": "Param ile ödeme almak için gereken anahtarlar.",
        "adm_title": "Param Ayarları",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "menu_param-gateway": "Param Ödeme",
        "menu_param-gateway_param_settings": "Param Ayarları",
        "module_param-gateway_name": "Param Ödeme Altyapısı",
        "module_param-gateway_description": "Param (TurkPos) üzerinden Türk kartı ve taksitli ödemeleri alın"
      }
    }
  },
  "permissions": [
    {
      "name": "param-gateway.manage",
      "labelKey": "paramGateway.perm_manage"
    }
  ]
}
