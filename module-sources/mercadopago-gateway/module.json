{
  "id": "mercadopago-gateway",
  "name": "Mercado Pago Gateway",
  "description": "Take card, Pix, boleto and cash payments across Latin America through Mercado Pago",
  "version": "1.3.2",
  "coreVersion": "^4.0.0",
  "secretSettings": [
    "mercadopago_access_token",
    "mercadopago_webhook_secret"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "Wallet",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "Mercado Pago",
      "description": "Mercado Pago access token and webhook secret.",
      "href": "/settings/mercadopago",
      "icon": "Wallet",
      "color": "text-yellow-500"
    }
  ],
  "menu": [
    {
      "label": "Mercado Pago Settings",
      "path": "/settings/mercadopago",
      "icon": "Wallet",
      "group": "commerce",
      "section": "payments",
      "permission": "mercadopago-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/mercadopago",
      "component": "pages/admin/page.tsx",
      "permission": "mercadopago-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/mercadopago/webhook",
      "providerCallback": true,
      "handler": "api/webhook/route.ts",
      "method": "POST",
      "description": "Mercado Pago notification. Reads the payment back and reports it through the payment contract."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    },
    {
      "hook": "payment.refunded",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "mercadopagoGateway": {
        "adm_accessToken": "Access Token",
        "adm_accessTokenDesc": "From your Mercado Pago dashboard.",
        "adm_subtitle": "Keys for taking payments through Mercado Pago.",
        "adm_title": "Mercado Pago Settings",
        "adm_webhookSecret": "Webhook Secret",
        "adm_webhookSecretDesc": "From your Mercado Pago dashboard. Point the Mercado Pago notification URL at /api/v1/mercadopago/webhook.",
        "perm_manage": "Manage"
      },
      "admin": {
        "menu_mercadopago-gateway": "Mercado Pago Gateway",
        "menu_mercadopago-gateway_mercado_pago_settings": "Mercado Pago Settings",
        "module_mercadopago-gateway_name": "Mercado Pago Gateway",
        "module_mercadopago-gateway_description": "Take card, Pix, boleto and cash payments across Latin America through Mercado Pago"
      }
    },
    "tr": {
      "mercadopagoGateway": {
        "adm_accessToken": "Erişim Anahtarı",
        "adm_accessTokenDesc": "Mercado Pago panelinden alınır.",
        "adm_subtitle": "Mercado Pago ile ödeme almak için gereken anahtarlar.",
        "adm_title": "Mercado Pago Ayarları",
        "adm_webhookSecret": "Webhook Gizli Anahtarı",
        "adm_webhookSecretDesc": "Mercado Pago panelinden alınır. Mercado Pago bildirim adresini /api/v1/mercadopago/webhook olarak ayarlayın.",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "menu_mercadopago-gateway": "Mercado Pago Ödeme",
        "menu_mercadopago-gateway_mercado_pago_settings": "Mercado Pago Ayarları",
        "module_mercadopago-gateway_name": "Mercado Pago Altyapısı",
        "module_mercadopago-gateway_description": "Mercado Pago üzerinden Latin Amerika genelinde kart, Pix, boleto ve nakit ödemelerini alın"
      }
    }
  },
  "permissions": [
    {
      "name": "mercadopago-gateway.manage",
      "labelKey": "mercadopagoGateway.perm_manage"
    }
  ]
}
