{
  "id": "vk-auth",
  "name": "VK Login",
  "description": "Allow users to sign in with their VK account",
  "version": "1.2.2",
  "coreVersion": "^4.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "MessagesSquare",
  "adminRoutes": [
    {
      "path": "/settings/vk-auth",
      "component": "pages/admin/settings/vk-auth/page.tsx",
      "permission": "vk-auth.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "VK OAuth",
      "description": "VK application credentials.",
      "href": "/settings/vk-auth",
      "icon": "MessagesSquare",
      "color": "text-blue-500"
    }
  ],
  "authProviders": [
    {
      "id": "vk",
      "envIdVar": "AUTH_VK_ID",
      "envSecretVar": "AUTH_VK_SECRET"
    }
  ],
  "oauthButtons": [
    {
