  "translations": {
    "en": {
      "vkAuth": {
        "adm_emailNote": "VK only passes on an email address when the account has a confirmed one and the person allows it. Without it the account gets a placeholder address that can never receive mail, and the user can set a real one in their profile.",
        "adm_subtitle": "Set up VK OAuth sign-in for your site.",
        "adm_title": "VK Login Settings",
        "perm_manage": "Manage"
      },
      "admin": {
        "module_vk-auth_name": "VK Login",
        "module_vk-auth_description": "Allow users to sign in with their VK account"
      }
    },
    "tr": {
      "vkAuth": {
        "adm_emailNote": "VK, yalnızca hesapta doğrulanmış bir e-posta varsa ve kişi izin verirse adresi paylaşır. Paylaşılmazsa hesaba posta alamayan geçici bir adres atanır; kullanıcı profilinden gerçek bir adres tanımlayabilir.",
        "adm_subtitle": "Siteniz için VK ile OAuth girişini yapılandırın.",
        "adm_title": "VK ile Giriş Ayarları",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "module_vk-auth_name": "VK ile Giriş",
        "module_vk-auth_description": "Kullanıcıların VK hesabıyla giriş yapmasına izin verin"
      }
    }
  },
  "permissions": [
    {
      "name": "vk-auth.manage",
      "labelKey": "vkAuth.perm_manage"
    }
  ]
}
