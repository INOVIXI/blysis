// Store Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// @@user-relations-start
//   orders Order[]
//   cart   CartItem[]
//   redeemedGifts GiftCode[] @relation("RedeemedGifts")
//   creatorCodes     CreatorCode[]      @relation("CreatorCodes")
//   ownedProducts    OwnedProduct[]     @relation("OwnedProducts")
//   chestItems       ChestItem[]        @relation("ChestItems")
//   stripeCustomerId String?
//   subscriptions    Subscription[]
// @@user-relations-end
// NOTE: User FK fields below are nullable + onDelete: SetNull so that
// deleting a user preserves their order/credit/subscription history for
// accounting + analytics. Cart items are per-user runtime state and
// cascade with the user (handled in CartItem with onDelete: Cascade).

// ==================== STORE MODULE ====================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  /**
   * Own any one of these products to see this shelf. Empty shows it to all.
   *
   * The one gate in the store that really hides: a product's prerequisite is
   * told to the shopper on purpose, a category kept back is kept back.
   */
  visibleAfterProductIds String[] @default([])
  parentId    String?
  parent      Category? @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([parentId])
}

model Product {
  id            String   @id @default(cuid())
  number        Int      @unique @default(autoincrement())
  name          String
  slug          String   @unique
  translations  Json?
  description   String?  @db.Text
  shortDesc     String?
  price         Decimal  @db.Decimal(10, 2)
  comparePrice  Decimal? @db.Decimal(10, 2)
  image         String?
  images        String[] @default([])
  stock         Int?
  /// Units sold, maintained at settlement and refund. Denormalised because
  /// ranking by an aggregate over every paid order item measured 90 ms.
  unitsSold     Int      @default(0)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  type          ProductType @default(DIGITAL)
  deliveryData  Json?
  subscriptionInterval      String?
  subscriptionIntervalCount Int?      @default(1)
  stripePriceId             String?

  // ---- When it is for sale -------------------------------------------
  //
  // The shop had one switch per product, so every shape a community
  // actually sells needed somebody watching a clock: a seasonal pack turned
  // on by hand on the 20th, a Friday evening offer somebody had to be awake
  // for, "one per account" enforced afterwards by apologising. The hours are
  // read on the site's own clock (Settings > Site), because "Friday at
  // 18:00" is not a moment until somebody says whose clock.
  /** The run. Absolute instants, so they mean the same thing everywhere. */
  availableFrom        DateTime?
  availableUntil       DateTime?
  /** Weekly window: 0 is Sunday. Empty means every day. */
  availableDays        Int[]     @default([])
  /** Minutes past midnight, site clock. Null means all day. May wrap. */
  availableFromMinute  Int?
  availableUntilMinute Int?
  /** countdown | hidden - what a visitor sees while it is shut. */
  outsideWindow        String    @default("countdown")
  /** Role ids that may buy it. Empty means anyone. Advertised, not hidden. */
  roleIds              String[]  @default([])
  /** How many one account may buy, and over what period. */
  perPersonLimit       Int?
  perPersonPeriod      String    @default("ever")
  /** An allowance that refills: "ten a day" rather than "ten, ever". */
  periodStock          Int?
  periodStockWindow    String    @default("day")
  /**
   * How long a purchase lasts, in days. Null is owned outright.
   *
   * Lives on the product rather than on a processor's subscription, so a shop
   * taking bank transfers can sell thirty days of something too.
   */
  durationDays         Int?
  /** A role the buyer is given on purchase. Null grants nothing. */
  grantsRoleId         String?
  /**
   * Products the buyer must already own. Empty asks for nothing.
   *
   * The shape every upgrade path has: the tier above is for people already on
   * the tier below.
   */
  requiresProductIds   String[]  @default([])
  /** Own any one of the list rather than all of it. */
  requiresAny          Boolean   @default(false)

  /** A sale with a start and an end, rather than a price somebody remembers. */
  salePrice            Decimal?  @db.Decimal(10, 2)
  saleFrom             DateTime?
  saleUntil            DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]
  cartItems  CartItem[]
  subscriptions Subscription[]
  campaignEntries CampaignEntry[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, unitsSold])
  // The list asks for what is on sale right now on every visit.
  @@index([isActive, availableFrom, availableUntil])
}

enum ProductType {
  DIGITAL
  PHYSICAL
  GAME_ITEM
  SUBSCRIPTION
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  /// An integer an integrator can hold and hand back. `id` is a cuid and
  /// `orderNumber` is a string the buyer reads; a pulling integrator's schema
  /// asks for an integer and returns it when the document is issued, so the
  /// value has to lead back to this row. See migrations/014.
  number        Int         @unique @default(autoincrement())
  status        OrderStatus @default(PENDING)
  total         Decimal     @db.Decimal(10, 2)
  subtotal      Decimal     @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  tax           Decimal     @default(0) @db.Decimal(10, 2)
  currency      String      @default("USD")
  paymentMethod String?
  paymentId     String?
  notes         String?
  metadata      Json?
  /**
   * Who the invoice is made out to, when anything here issues one.
   *
   * Null on a shop that issues none, which is most of them: asking every
   * buyer for a tax number is a longer checkout for a field nobody reads.
   * JSON rather than columns because what a tax authority wants differs by
   * country, and the module talking to one is the only thing that knows.
   */
  billingDetails Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])

  // The revenue chart and the community goal both scan a date window.
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)
  name      String
  metadata  Json?

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model CartItem {
  id       String @id @default(cuid())
  quantity Int    @default(1)

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  provider      String
  providerId    String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([providerId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Coupon {
  id            String      @id @default(cuid())
  code          String      @unique
  description   String?
  type          CouponType  @default(PERCENTAGE)
  value         Decimal     @db.Decimal(10, 2)
  minPurchase   Decimal?    @db.Decimal(10, 2)
  maxDiscount   Decimal?    @db.Decimal(10, 2)
  usageLimit    Int?
  usageCount    Int         @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  /// Which products the code works on. Empty is every product, which is what
  /// every coupon written before there was a way to say otherwise meant.
  productIds    String[]
  /// Which categories the code works on. Empty is every category. A line
  /// matching either list is covered once.
  categoryIds   String[]
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([isActive])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model OwnedProduct {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("OwnedProducts", fields: [userId], references: [id], onDelete: SetNull)
  productId String
  orderId   String?
  /** When it lapses. Null is owned outright, which no purchase can undo. */
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  // The sweep asks for every ownership that has lapsed, newest schema first.
  @@index([expiresAt])
}

/**
 * A price change an operator sets once and lets run on a clock.
 *
 * The rules are the ones a product already has - a weekly window, a price,
 * an allowance - gathered under a name so ten products move together and come
 * back together. Setting them ten times by hand is how a shop ends up with
 * nine on offer and one missed, then nine that never came off.
 */
model Campaign {
  id           String   @id @default(cuid())
  name         String
  isActive     Boolean  @default(true)
  /** Weekdays it runs on, 0 is Sunday. Empty means every day. */
  days         Int[]    @default([])
  /** Minutes past midnight on the site's clock. Null means all day. */
  fromMinute   Int?
  untilMinute  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries CampaignEntry[]

  @@index([isActive])
}

model CampaignEntry {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /** What the product costs while the campaign runs. */
  price      Decimal  @db.Decimal(10, 2)
  /** How many may go at that price before it stops. Null is no limit. */
  stock      Int?

  // One entry per product per campaign: two would be two prices with nothing
  // to choose between them.
  @@unique([campaignId, productId])
  @@index([productId])
}

model BulkDiscount {
  id           String   @id @default(cuid())
  name         String
  minQuantity  Int
  discountPercent Int
  /// Which products the rule covers. Empty is every product, which is what
  /// every rule written before there was a way to say otherwise meant.
  productIds   String[]
  /// Which categories the rule covers. Empty is every category. A line named
  /// by either list is covered once.
  categoryIds  String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model GiftCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  value       Decimal   @db.Decimal(10, 2)
  isRedeemed  Boolean   @default(false)
  redeemedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  redeemedById String?
  redeemedBy   User?   @relation("RedeemedGifts", fields: [redeemedById], references: [id], onDelete: SetNull)
  createdById  String?

  @@index([redeemedById])
}

model ProductVariable {
  id          String  @id @default(cuid())
  productId   String
  name        String
  label       String
  type        String  @default("text")
  required    Boolean @default(true)
  placeholder String?
  options     String?

  @@index([productId])
}

model ProductCommand {
  id        String  @id @default(cuid())
  productId String
  command   String
  serverId  String?
  order     Int     @default(0)

  @@index([productId])
}

model ChestItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("ChestItems", fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  quantity    Int      @default(1)
  /**
   * The answers taken at checkout, kept until the item is claimed.
   *
   * Checkout asks for the name to deliver to separately from the name the
   * buyer signed in with, because those differ on every site that delivers
   * into a game. Without these two columns a claim ran the product's commands
   * with the account's username and none of the fields the buyer filled in.
   * Null on a row nobody bought - one an operator put there by hand - and the
   * screen asks at claim time.
   */
  playerName  String?
  variables   Json?
  isRedeemed  Boolean  @default(false)
  redeemedAt  DateTime?
  giftedToId  String?
  orderId     String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model CreatorCode {
  id              String   @id @default(cuid())
  code            String   @unique
  creatorId       String?
  creator         User?    @relation("CreatorCodes", fields: [creatorId], references: [id], onDelete: SetNull)
  discountPercent Int      @default(5)
  commissionPercent Int    @default(5)
  usageCount      Int      @default(0)
  totalRevenue    Decimal  @default(0) @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([creatorId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  stripeSubscriptionId String   @unique
  status               String   @default("active")
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([productId])
}

/// Credits sold in a bundle, with a bonus for buying more.
///
/// The shop sold credits by the unit, which sells nothing: there is no reason
/// to buy a thousand rather than a hundred. The bonus is a second number and
/// never part of the price - a gateway is asked for `price` and the buyer
/// receives `credits + bonusCredits`.
model CreditPackage {
  id           String   @id @default(cuid())
  name         String
  credits      Int
  /// Given on top. Never reaches the charge.
  bonusCredits Int      @default(0)
  price        Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, order])
}
