        "adm_title": "PayPal Ayarları",
        "adm_subtitle": "PayPal ödeme ağ geçidini yapılandırın",
        "adm_field1Label": "İstemci Kimliği",
        "adm_field1Desc": "PayPal uygulama İstemci Kimliği",
        "adm_field2Label": "İstemci Sırrı",
        "adm_field2Desc": "PayPal uygulama İstemci Sırrı",
