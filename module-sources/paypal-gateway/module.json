      "admin": {
        "menu_paypal-gateway": "PayPal Ayarları",
        "title": "Yönetim Paneli",
        "subtitle": "Platform ayarlarınızı ve içeriklerinizi yönetin",
        "menu_paypal-gateway_paypal_settings": "PayPal Ayarları",
        "module_paypal-gateway_name": "PayPal Ödeme Altyapısı",
        "module_paypal-gateway_description": "PayPal üzerinden bakiye veya bağlı kartla ödeme alın"
      }
    }
  },
  "api": [
    {
      "path": "/paypal/capture",
      "handler": "api/capture/route.ts",
      "method": "GET",
      "description": "Where PayPal returns the buyer. Captures the payment and reports it through the payment contract."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "permissions": [
    "paypal-gateway.manage"
  ]
}
