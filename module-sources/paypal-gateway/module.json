      },
      "admin": {
        "menu_paypal-gateway": "Paypal Gateway",
        "title": "Admin Panel",
        "subtitle": "Manage your platform settings and content",
        "menu_paypal-gateway_paypal_settings": "PayPal Settings",
        "module_paypal-gateway_name": "PayPal Payment Gateway",
        "module_paypal-gateway_description": "Take payments through PayPal, with a balance or a linked card"
      }
    },
    "tr": {
      "paypalGateway": {
        "title": "PayPal Ayarları",
        "description": "PayPal ödeme ağırlığı yapılandırması",
        "clientId": "İstemci Kimlik Numarası",
        "clientSecret": "İstemci Gizli Anahtarı",
        "enabled": "Etkin",
