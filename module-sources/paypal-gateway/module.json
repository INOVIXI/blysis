{
  "id": "paypal-gateway",
  "name": "PayPal Payment Gateway",
  "description": "Take payments through PayPal, with a balance or a linked card",
  "version": "2.3.2",
  "coreVersion": "^4.0.0",
  "secretSettings": [
    "paypal_client_secret"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "DollarSign",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "PayPal",
      "description": "PayPal API credentials.",
      "href": "/settings/paypal",
      "icon": "DollarSign",
      "color": "text-blue-500"
    }
  ],
  "menu": [
    {
      "label": "PayPal Settings",
      "path": "/settings/paypal",
      "icon": "DollarSign",
      "group": "commerce",
      "section": "payments",
      "permission": "paypal-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/paypal",
      "component": "pages/admin/page.tsx",
      "permission": "paypal-gateway.manage"
    }
  ],
  "translations": {
    "en": {
      "paypalGateway": {
        "title": "PayPal Settings",
