{
  "id": "member-profiles",
  "name": "Member Profiles",
  "description": "Public profile pages, with what every installed module knows about a member",
  "version": "1.8.0",
  "coreVersion": "^5.26.0",
  "category": "gaming",
  "author": "Blysis",
  "icon": "Users",
  "routes": [
    {
      "path": "/u/[username]",
      "component": "pages/public/[username]/page.tsx",
      "resolver": "lib/route-exists.ts",
      "titleKey": "pageTitles.member",
      "descriptionKey": "pageDescriptions.member",
      "userProfile": true,
      "ogType": "profile"
    },
    {
      "path": "/u/[username]/content",
      "component": "pages/public/[username]/content/page.tsx",
      "resolver": "lib/route-exists.ts",
      "titleKey": "pageTitles.memberContent",
      "descriptionKey": "pageDescriptions.memberContent"
    }
  ],
  "profileTabs": [
    {
      "id": "ProfileAccountsTab",
      "label": "Accounts",
      "component": "components/ProfileAccountsTab",
      "order": 60,
      "labelKey": "memberProfiles.profileTab"
    }
  ],
  "api": [
    {
      "path": "/members/[username]",
      "handler": "api/[username]/route.ts",
      "description": "Get a public member profile by username.",
      "openTo": "public"
    },
    {
      "path": "/members/[username]/content",
      "handler": "api/[username]/content/route.ts",
      "description": "List what a member has written, by kind.",
      "openTo": "public"
    },
    {
      "path": "/linked-accounts",
      "handler": "api/linked-accounts/route.ts",
      "description": "Read the accounts a member has proved are theirs.",
      "openTo": "member"
    },
    {
      "path": "/members/linked-accounts",
      "handler": "api/linked-accounts/route.ts",
      "description": "List, link, or unlink connected game accounts for the current user.",
      "openTo": "member"
    }
  ],
