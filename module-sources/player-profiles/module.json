        "linkedAccounts": "Linked Accounts",
        "noLinkedAccounts": "No linked accounts",
        "statistics": "Statistics",
        "playerNotFound": "Member not found",
        "searchPlaceholder": "Enter username...",
        "rank": "Rank",
        "badges": "Badges",
        "activity": "Activity",
        "stat_orders": "Orders",
        "stat_topics": "Topics",
        "stat_posts": "Posts",
        "stat_comments": "Comments",
        "stat_suggestions": "Suggestions",
        "accounts": "Accounts",
        "profileTab": "Linked accounts",
        "linksAreManagedByTheirModule": "Each link is managed where it was made, in that game's own section."
      },
      "pageTitles": {
        "player": "Member Profile"
      },
      "admin": {
        "module_player-profiles_name": "Member Profiles",
        "module_player-profiles_description": "Public profile pages, with what every installed module knows about a member"
      },
      "pageDescriptions": {
        "player": "See a member's public profile: when they joined, the rank they hold and what they have posted across the community."
      }
