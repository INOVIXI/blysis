{
  "id": "player-profiles",
  "name": "Member Profiles",
  "description": "Public profile pages, with what every installed module knows about a member",
  "version": "1.6.2",
  "coreVersion": "^4.0.0",
  "category": "gaming",
  "author": "Blysis",
  "icon": "Users",
  "routes": [
    {
      "path": "/player/[username]",
      "component": "pages/public/[username]/page.tsx",
      "resolver": "lib/route-exists.ts",
      "titleKey": "pageTitles.player",
      "descriptionKey": "pageDescriptions.player",
      "userProfile": true,
      "ogType": "profile"
    }
  ],
  "profileTabs": [
    {
      "id": "ProfileAccountsTab",
      "label": "Accounts",
      "component": "components/ProfileAccountsTab",
      "order": 60,
      "labelKey": "playerProfiles.profileTab"
    }
  ],
  "api": [
    {
      "path": "/players/[username]",
      "handler": "api/[username]/route.ts",
      "description": "Get a public player profile by username.",
      "openTo": "public"
    },
    {
      "path": "/linked-accounts",
      "handler": "api/linked-accounts/route.ts",
      "description": "Read the accounts a member has proved are theirs.",
      "openTo": "member"
    },
    {
      "path": "/players/linked-accounts",
      "handler": "api/linked-accounts/route.ts",
      "description": "List, link, or unlink connected game accounts for the current user.",
      "openTo": "member"
    }
  ],
  "translations": {
    "en": {
      "playerProfiles": {
        "title": "Member Profile",
        "username": "Username",
        "joinDate": "Join Date",
        "online": "Online",
