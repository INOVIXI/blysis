{
  "id": "csv-import-export",
  "name": "CSV Export",
  "description": "Export the site's tables as CSV",
  "version": "1.3.0",
  "coreVersion": "^5.0.0",
  "category": "management",
  "author": "Blysis",
  "icon": "Download",
  "permissions": [
    {
      "name": "admin.export",
      "labelKey": "csvImportExport.perm_export"
    }
  ],
  "menu": [
    {
      "label": "Export",
      "path": "/export",
      "icon": "Download",
      "group": "system",
      "section": "operations",
      "permission": "admin.export"
    }
  ],
  "adminRoutes": [
    {
      "path": "/export",
      "component": "pages/admin/page.tsx",
      "permission": "admin.export"
    }
  ],
  "api": [
    {
      "path": "/admin/export",
      "handler": "api/export/route.ts",
      "description": "Export tabular data to CSV (admin).",
      "permission": "admin.export"
    }
  ],
  "dependencies": [
    "store"
  ],
  "translations": {
    "en": {
      "admin": {
        "menu_csv-import-export": "Csv Export",
        "menu_csv-import-export_export": "Export",
        "module_csv-import-export_description": "Export the site's tables as CSV",
        "module_csv-import-export_name": "CSV Export"
      },
      "csvImportExport": {
        "adm_export": "Export",
        "adm_exportSubtitle": "Hand any of these over as a CSV file",
        "adm_exportTitle": "Export",
        "adm_exportUsers": "Members",
        "adm_nothingToExport": "Nothing installed here exports anything yet.",
        "perm_export": "Export data"
      }
    },
    "tr": {
      "admin": {
        "menu_csv-import-export": "Csv Dışa Aktarma",
        "menu_csv-import-export_export": "Dışa Aktarma",
        "module_csv-import-export_description": "Sitenin tablolarını CSV olarak dışa aktarın",
        "module_csv-import-export_name": "CSV Dışa Aktarma"
      },
      "csvImportExport": {
        "adm_export": "Dışa aktar",
        "adm_exportSubtitle": "Bunlardan herhangi birini CSV dosyası olarak alın",
        "adm_exportTitle": "Dışa Aktarma",
        "adm_exportUsers": "Üyeler",
        "adm_nothingToExport": "Burada kurulu hiçbir şey henüz bir şey dışa aktarmıyor.",
        "perm_export": "Veri dışa aktarabilir"
      }
    }
  },
  "hooksEmitted": [
    {
      "hook": "csv.exports",
      "type": "filter"
    }
  ]
