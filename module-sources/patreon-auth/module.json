{
  "id": "patreon-auth",
  "name": "Patreon Login",
  "description": "Allow users to sign in with their Patreon account",
  "version": "1.2.2",
  "coreVersion": "^3.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "Heart",
  "adminRoutes": [
    {
      "path": "/settings/patreon-auth",
      "component": "pages/admin/settings/patreon-auth/page.tsx",
      "permission": "patreon-auth.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "Patreon OAuth",
      "description": "Patreon application credentials.",
      "href": "/settings/patreon-auth",
      "icon": "Heart",
      "color": "text-rose-500"
    }
  ],
  "authProviders": [
    {
      "id": "patreon",
      "envIdVar": "AUTH_PATREON_ID",
      "envSecretVar": "AUTH_PATREON_SECRET"
    }
  ],
  "oauthButtons": [
    {
      "id": "patreon-login",
      "provider": "patreon",
      "label": "Patreon",
      "color": "#FF424D",
      "svgIcon": "M22.957 7.21c-.004-3.064-2.391-5.576-5.191-6.482-3.478-1.125-8.064-.962-11.384.604C2.357 3.231 1.093 7.391 1.046 11.54c-.039 3.411.302 12.396 5.369 12.46 3.765.047 4.326-4.804 6.068-7.141 1.24-1.662 2.836-2.132 4.801-2.618 3.376-.836 5.678-3.501 5.673-7.031Z"
    }
  ],
  "translations": {
    "en": {
      "patreonAuth": {
        "adm_title": "Patreon Login Settings",
        "adm_subtitle": "Set up Patreon OAuth sign-in for your site."
      },
      "admin": {
        "module_patreon-auth_name": "Patreon Login",
        "module_patreon-auth_description": "Allow users to sign in with their Patreon account"
      }
    },
    "tr": {
      "patreonAuth": {
        "adm_title": "Patreon ile Giriş Ayarları",
        "adm_subtitle": "Siteniz için Patreon ile OAuth girişini yapılandırın."
      },
      "admin": {
        "module_patreon-auth_name": "Patreon ile Giriş",
        "module_patreon-auth_description": "Kullanıcıların Patreon hesabıyla giriş yapmasına izin verin"
      }
    }
  },
  "permissions": [
    "patreon-auth.manage"
  ]
}
