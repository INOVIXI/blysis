{
  "id": "paymentwall-gateway",
  "name": "Paymentwall Gateway",
  "description": "Take local payments, wallets and mobile billing through Paymentwall",
  "version": "1.3.2",
  "coreVersion": "^4.0.0",
  "secretSettings": [
    "paymentwall_secret_key"
  ],
  "category": "commerce",
  "author": "Blysis",
  "icon": "Globe",
  "dependencies": [
    "store@^2.0.0"
  ],
  "settingsCards": [
    {
      "title": "Paymentwall",
      "description": "Paymentwall project and secret keys.",
      "href": "/settings/paymentwall",
      "icon": "Globe",
      "color": "text-fuchsia-500"
    }
  ],
  "menu": [
    {
      "label": "Paymentwall Settings",
      "path": "/settings/paymentwall",
      "icon": "Globe",
      "group": "commerce",
      "section": "payments",
      "permission": "paymentwall-gateway.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/paymentwall",
      "component": "pages/admin/page.tsx",
      "permission": "paymentwall-gateway.manage"
    }
  ],
  "api": [
    {
      "path": "/paymentwall/pingback",
      "handler": "api/pingback/route.ts",
      "method": "GET",
      "description": "Paymentwall pingback. Verifies the signature and reports the payment through the payment contract."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.refunded",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ],
  "translations": {
    "en": {
      "paymentwallGateway": {
        "adm_projectKey": "Project Key",
        "adm_projectKeyDesc": "From your Paymentwall dashboard.",
        "adm_secretKey": "Secret Key",
        "adm_secretKeyDesc": "From your Paymentwall dashboard. Point the Paymentwall notification URL at /api/v1/paymentwall/pingback.",
        "adm_subtitle": "Keys for taking payments through Paymentwall.",
        "adm_title": "Paymentwall Settings",
        "perm_manage": "Manage"
      },
      "admin": {
        "menu_paymentwall-gateway": "Paymentwall Gateway",
        "menu_paymentwall-gateway_paymentwall_settings": "Paymentwall Settings",
        "module_paymentwall-gateway_name": "Paymentwall Gateway",
        "module_paymentwall-gateway_description": "Take local payments, wallets and mobile billing through Paymentwall"
      }
    },
    "tr": {
      "paymentwallGateway": {
        "adm_projectKey": "Proje Anahtarı",
        "adm_projectKeyDesc": "Paymentwall panelinden alınır.",
        "adm_secretKey": "Gizli Anahtar",
        "adm_secretKeyDesc": "Paymentwall panelinden alınır. Paymentwall bildirim adresini /api/v1/paymentwall/pingback olarak ayarlayın.",
        "adm_subtitle": "Paymentwall ile ödeme almak için gereken anahtarlar.",
        "adm_title": "Paymentwall Ayarları",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "menu_paymentwall-gateway": "Paymentwall Ödeme",
        "menu_paymentwall-gateway_paymentwall_settings": "Paymentwall Ayarları",
        "module_paymentwall-gateway_name": "Paymentwall Altyapısı",
        "module_paymentwall-gateway_description": "Paymentwall üzerinden yerel ödemeleri, cüzdanları ve mobil faturalandırmayı kullanın"
      }
    }
  },
  "permissions": [
    {
      "name": "paymentwall-gateway.manage",
      "labelKey": "paymentwallGateway.perm_manage"
    }
  ]
}
