{
  "id": "discord-integration",
  "name": "Discord Integration",
  "description": "Discord webhook notifications and settings",
  "version": "1.5.2",
  "coreVersion": "^3.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "MessageSquare",
  "menu": [
    {
      "label": "Discord",
      "path": "/discord",
      "icon": "MessageSquare",
      "group": "system",
      "section": "integrations"
    }
  ],
  "adminRoutes": [
    {
      "path": "/discord",
      "component": "pages/admin/page.tsx"
    },
    {
      "path": "/discord/messages",
      "component": "pages/admin/messages/page.tsx"
    }
  ],
  "settingsCards": [
    {
      "title": "Discord",
      "description": "Discord webhook notifications.",
      "href": "/discord",
      "icon": "MessageSquare",
      "color": "text-indigo-500"
    }
  ],
  "webhookChannels": [
    {
      "id": "discord",
      "label": "Discord",
      "layout": "embed",
      "hosts": [
        "discord.com",
        "discordapp.com"
      ],
      "urlPlaceholder": "https://discord.com/api/webhooks/..."
    }
  ],
  "hookListeners": [
    {
      "hook": "user.registered",
      "type": "action",
      "handler": "listeners/user-registered.ts"
    },
    {
      "hook": "blog.article.created",
      "type": "action",
      "handler": "listeners/blog-article-created.ts"
    },
    {
      "hook": "forum.topic.created",
      "type": "action",
      "handler": "listeners/forum-topic-created.ts"
    },
    {
      "hook": "tickets.ticket.opened",
      "type": "action",
      "handler": "listeners/ticket-opened.ts"
    },
    {
      "hook": "store.order.created",
      "type": "action",
      "handler": "listeners/order-created.ts"
    },
    {
      "hook": "store.order.completed",
      "type": "action",
      "handler": "listeners/order-completed.ts"
    }
  ],
