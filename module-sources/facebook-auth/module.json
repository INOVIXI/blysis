{
  "id": "facebook-auth",
  "name": "Facebook Login",
  "description": "Allow users to sign in with their Facebook account",
  "version": "1.2.2",
  "coreVersion": "^3.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "Users",
  "adminRoutes": [
    {
      "path": "/settings/facebook-auth",
      "component": "pages/admin/settings/facebook-auth/page.tsx"
    }
  ],
  "settingsCards": [
    {
      "title": "Facebook OAuth",
      "description": "Facebook application credentials.",
      "href": "/settings/facebook-auth",
      "icon": "Users",
      "color": "text-blue-600"
    }
  ],
  "authProviders": [
    {
      "id": "facebook",
      "envIdVar": "AUTH_FACEBOOK_ID",
      "envSecretVar": "AUTH_FACEBOOK_SECRET"
    }
  ],
  "oauthButtons": [
    {
      "id": "facebook-login",
      "provider": "facebook",
      "label": "Facebook",
      "color": "#0866FF",
      "svgIcon": "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"
    }
  ],
  "translations": {
    "en": {
      "facebookAuth": {
        "adm_title": "Facebook Login Settings",
        "adm_subtitle": "Set up Facebook OAuth sign-in for your site."
      },
      "admin": {
        "module_facebook-auth_name": "Facebook Login",
        "module_facebook-auth_description": "Allow users to sign in with their Facebook account"
      }
    },
    "tr": {
      "facebookAuth": {
        "adm_title": "Facebook ile Giriş Ayarları",
        "adm_subtitle": "Siteniz için Facebook ile OAuth girişini yapılandırın."
      },
      "admin": {
        "module_facebook-auth_name": "Facebook ile Giriş",
        "module_facebook-auth_description": "Kullanıcıların Facebook hesabıyla giriş yapmasına izin verin"
      }
    }
  }
}
