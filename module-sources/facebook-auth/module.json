  "coreVersion": "^5.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "Users",
  "adminRoutes": [
    {
      "path": "/settings/facebook-auth",
      "component": "pages/admin/settings/facebook-auth/page.tsx",
      "permission": "facebook-auth.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "Facebook OAuth",
      "description": "Facebook application credentials.",
      "href": "/settings/facebook-auth",
      "icon": "Users",
      "color": "text-blue-600"
    }
  ],
  "authProviders": [
    {
      "id": "facebook",
      "envIdVar": "AUTH_FACEBOOK_ID",
      "envSecretVar": "AUTH_FACEBOOK_SECRET"
    }
  ],
