  "api": [
    {
      "path": "/webhooks/stripe",
      "providerCallback": true,
      "handler": "api/webhook/route.ts",
      "method": "POST",
      "description": "Stripe webhook receiver. Verifies the signature and reports payments through the payment contract."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "payment.settled",
      "type": "filter"
    },
    {
      "hook": "payment.voided",
      "type": "filter"
    },
    {
      "hook": "payment.refunded",
      "type": "filter"
    },
    {
      "hook": "subscription.changed",
      "type": "filter"
    }
  ],
  "hookListeners": [
    {
      "hook": "payment.providers",
      "type": "filter",
      "handler": "hooks/on-payment-providers.ts"
    },
    {
      "hook": "payment.session",
      "type": "filter",
      "handler": "hooks/on-payment-session.ts"
    }
  ]
}
