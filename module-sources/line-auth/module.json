{
  "id": "line-auth",
  "name": "LINE Login",
  "description": "Allow users to sign in with their LINE account",
  "version": "1.2.2",
  "coreVersion": "^3.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "MessageCircle",
  "adminRoutes": [
    {
      "path": "/settings/line-auth",
      "component": "pages/admin/settings/line-auth/page.tsx"
    }
  ],
  "settingsCards": [
    {
      "title": "LINE OAuth",
      "description": "LINE channel credentials.",
      "href": "/settings/line-auth",
      "icon": "MessageCircle",
      "color": "text-emerald-500"
    }
  ],
  "authProviders": [
    {
      "id": "line",
      "envIdVar": "AUTH_LINE_ID",
      "envSecretVar": "AUTH_LINE_SECRET"
    }
  ],
  "oauthButtons": [
