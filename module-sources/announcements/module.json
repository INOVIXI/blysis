{
  "id": "announcements",
  "name": "Announcements",
  "description": "Site-wide announcement banners",
  "version": "1.3.0",
  "coreVersion": "^5.0.0",
  "category": "management",
  "author": "Blysis",
  "icon": "Megaphone",
  "permissions": [
    {
      "name": "announcements.manage",
      "labelKey": "announcements.perm_manage"
    }
  ],
  "menu": [
    {
      "label": "Announcements",
      "path": "/announcements",
      "icon": "Megaphone",
      "group": "content",
      "section": "publishing",
      "permission": "announcements.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/announcements",
      "component": "pages/admin/page.tsx",
      "permission": "announcements.manage"
    }
  ],
  "api": [
    {
      "path": "/announcements",
      "handler": "api/route.ts",
      "description": "List public announcements and create new ones (admin).",
      "permission": "announcements.manage"
    },
    {
      "path": "/announcements/[id]",
      "handler": "api/[id]/route.ts",
      "description": "Update or delete a single announcement (admin).",
      "permission": "announcements.manage"
    },
    {
      "path": "/announcements/admin",
      "handler": "api/admin/route.ts",
      "description": "Every announcement, live or not, for the screen that manages them (admin).",
      "permission": "announcements.manage"
    }
  ],
  "hooksEmitted": [
    {
      "hook": "announcements.announcement.created",
      "type": "action"
    },
    {
      "hook": "announcements.announcement.deleted",
      "type": "action"
    },
    {
      "hook": "announcements.announcement.updated",
      "type": "action"
    }
  ],
