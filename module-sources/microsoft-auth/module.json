{
  "id": "microsoft-auth",
  "name": "Microsoft and Xbox Login",
  "description": "Allow users to sign in with their Microsoft or Xbox account",
  "version": "1.3.1",
  "coreVersion": "^5.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "Gamepad2",
  "adminRoutes": [
    {
      "path": "/settings/microsoft-auth",
      "component": "pages/admin/settings/microsoft-auth/page.tsx",
      "permission": "microsoft-auth.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "Microsoft OAuth",
      "description": "Microsoft Entra application credentials.",
      "href": "/settings/microsoft-auth",
      "icon": "Gamepad2",
      "color": "text-green-600"
    }
  ],
  "authProviders": [
    {
      "id": "microsoft-entra-id",
      "envIdVar": "AUTH_MICROSOFT_ENTRA_ID_ID",
      "envSecretVar": "AUTH_MICROSOFT_ENTRA_ID_SECRET"
    }
  ],
  "oauthButtons": [
    {
      "id": "microsoft-login",
      "provider": "microsoft-entra-id",
      "label": "Microsoft",
      "color": "#107C10",
      "svgIcon": "M4.102 21.033C6.211 22.881 8.977 24 12 24c3.026 0 5.789-1.119 7.902-2.967 1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417zm11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912C23.002 17.48 24 14.861 24 12.004c0-3.34-1.365-6.362-3.57-8.536 0 0-.027-.022-.082-.042-.063-.022-.152-.045-.281-.045-.592 0-1.985.434-4.805 3.246zM3.654 3.426c-.057.02-.082.041-.086.042C1.365 5.642 0 8.664 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245-.131 0-.223.021-.281.046v-.002zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545v.006z"
    }
  ],
  "translations": {
    "en": {
      "microsoftAuth": {
        "adm_subtitle": "Set up Microsoft OAuth sign-in for your site.",
        "adm_tenantNote": "A single-tenant application also needs AUTH_MICROSOFT_ENTRA_ID_ISSUER set to https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0. Left unset, sign-in runs against the shared /common/ endpoint, which accepts any Microsoft or Xbox account.",
        "adm_title": "Microsoft Login Settings",
        "perm_manage": "Manage"
      },
      "admin": {
        "module_microsoft-auth_name": "Microsoft and Xbox Login",
        "module_microsoft-auth_description": "Allow users to sign in with their Microsoft or Xbox account",
        "settings_microsoft-auth": "Microsoft OAuth",
        "settings_microsoft-auth_description": "Microsoft Entra application credentials."
      }
    },
    "tr": {
      "microsoftAuth": {
        "adm_subtitle": "Siteniz için Microsoft ile OAuth girişini yapılandırın.",
        "adm_tenantNote": "Tek kiracılı (single-tenant) bir uygulama için ayrıca AUTH_MICROSOFT_ENTRA_ID_ISSUER değişkenini https://login.microsoftonline.com/KIRACI-ID/v2.0 olarak ayarlayın. Boş bırakılırsa giriş, her Microsoft veya Xbox hesabını kabul eden ortak /common/ uç noktası üzerinden yapılır.",
        "adm_title": "Microsoft ile Giriş Ayarları",
        "perm_manage": "Yönetebilir"
      },
      "admin": {
        "module_microsoft-auth_name": "Microsoft ve Xbox ile Giriş",
        "module_microsoft-auth_description": "Kullanıcıların Microsoft veya Xbox hesabıyla giriş yapmasına izin verin",
        "settings_microsoft-auth": "Microsoft OAuth",
        "settings_microsoft-auth_description": "Microsoft Entra uygulama kimlik bilgileri."
      }
    }
  },
  "permissions": [
    {
      "name": "microsoft-auth.manage",
      "labelKey": "microsoftAuth.perm_manage"
    }
  ]
}
