  ],
  "hookListeners": [
    {
      "hook": "credits.award",
      "type": "filter",
      "handler": "hooks/on-credits-award.ts"
    },
    {
      "hook": "store.order.completed",
      "type": "action",
      "handler": "hooks/on-order-completed.ts"
    },
    {
      "hook": "credit.change",
      "type": "filter",
      "handler": "hooks/change.ts"
    }
  ],
  "adminRoutes": [
    {
      "path": "/settings/credits",
      "component": "pages/admin/page.tsx",
      "permission": "credits.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "Credits",
      "description": "How much of a purchase comes back as credits.",
      "href": "/settings/credits",
      "icon": "Coins",
      "color": "text-amber-500"
    }
  ],
  "userDataExport": [
    {
      "model": "creditTransaction",
      "key": "credits.creditTransactions",
      "column": "userId",
      "erasure": "retain"
    }
  ],
