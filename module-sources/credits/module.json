{
  "id": "credits",
  "name": "Credit System",
  "description": "Virtual currency wallet for users",
  "version": "1.6.2",
  "coreVersion": "^3.0.0",
  "category": "commerce",
  "author": "Blysis",
  "icon": "Coins",
  "permissions": [
    "credits.view",
    "credits.manage"
  ],
  "profileTabs": [
    {
      "id": "credits",
      "label": "Credits",
      "component": "components/CreditsTab.tsx",
      "order": 35,
      "labelKey": "credits.profileTab"
    }
  ],
  "api": [
    {
      "path": "/credits",
      "handler": "api/credits/route.ts",
      "description": "Get the current user credit balance."
    },
    {
      "path": "/credits/purchase",
      "handler": "api/credits/purchase/route.ts",
      "description": "Purchase credits via the configured payment gateway."
    }
  ],
  "dependencies": [],
  "hooksEmitted": [
    {
      "hook": "credits.credit.added",
      "type": "action"
    },
    {
      "hook": "credits.award",
      "type": "filter"
    }
  ],
