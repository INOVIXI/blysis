// Tickets Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// @@user-relations-start
//   tickets        Ticket[]
//   ticketMessages TicketMessage[]
//   assignedTickets Ticket[] @relation("AssignedTickets")
// @@user-relations-end

// ==================== TICKETS MODULE ====================

model TicketDepartment {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
  fields      TicketDepartmentField[]
  permissions TicketDepartmentPermission[]
}

/// An extra question on the form for one department.
///
/// The answers are stored with the label as it was asked; see lib/fields.ts
/// for why looking the label up later loses old tickets their questions.
model TicketDepartmentField {
  id           String @id @default(cuid())
  departmentId String
  department   TicketDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// What the form posts. Stable; the label is what changes.
  key          String
  label        String
  /// text | select. Anything else is read as text.
  type         String  @default("text")
  required     Boolean @default(false)
  /// For a select. The list is the question.
  options      String[] @default([])
  order        Int      @default(0)

  @@unique([departmentId, key])
  @@index([departmentId, order])
}

/// Which roles may open a ticket in a department.
///
/// A department with no rows is open to everybody; one with rows that do not
/// name a role is shut to it. The two silences mean opposite things on
/// purpose, and the argument is in the SDK rather than here.
model TicketDepartmentPermission {
  id           String @id @default(cuid())
  departmentId String
  department   TicketDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleId       String
  canView      Boolean @default(true)
  canPost      Boolean @default(true)
  canReply     Boolean @default(true)

  @@unique([departmentId, roleId])
  @@index([roleId])
}

model Ticket {
  id          String         @id @default(cuid())
  subject     String
  /// The key of a `TicketStatus` row. A plain string, because which states
  /// a desk has is the operator's to decide and a database type is not.
  status      String         @default("OPEN")
  /// The key of a `TicketPriority` row, for the same reason.
  priority    String         @default("MEDIUM")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?

  /// The extra questions, answered, with the label each one had at the time.
  fieldAnswers Json?

  departmentId String
  department   TicketDepartment @relation(fields: [departmentId], references: [id])
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?            @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages TicketMessage[]

  @@index([userId])
  @@index([departmentId])
  @@index([status])
  @@index([assignedToId])

  // The stats screen scans a date window.
  @@index([createdAt])
}

/**
 * A state a ticket can be in, as the operator names it.
 *
 * `isOpen` is what the dashboard and the counts mean by "open" and
 * `closesTicket` is what stamps `closedAt`; both were written into three
 * files as `status === "CLOSED" || status === "RESOLVED"`, which is a rule
 * that cannot survive an operator renaming anything.
 */
model TicketStatus {
  id           String  @id @default(cuid())
  key          String  @unique
  /// The word an operator typed. Null for one this module ships.
  name         String?
  /// The key this module translates it under. Null for one an operator added.
  nameKey      String?
  tone         String  @default("neutral")
  isOpen       Boolean @default(true)
  closesTicket Boolean @default(false)
  order        Int     @default(0)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())

  @@index([isActive, order])
}

/** How urgent a ticket is, as the operator names it. */
model TicketPriority {
  id        String  @id @default(cuid())
  key       String  @unique
  name      String?
  nameKey   String?
  tone      String  @default("neutral")
  order     Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, order])
}

model TicketMessage {
  id          String   @id @default(cuid())
  content     String   @db.Text
  isStaffReply Boolean @default(false)
  attachments String[] @default([])
  createdAt   DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([userId])
}

model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
