{
  "id": "referral",
  "name": "Referral System",
  "description": "Earn credits by referring new users",
  "version": "1.6.2",
  "coreVersion": "^4.0.0",
  "category": "community",
  "author": "Blysis",
  "icon": "UserPlus",
  "dependencies": [
    "store",
    "credits@^1.4.0"
  ],
  "permissions": [
    "referral.manage"
  ],
  "routes": [
    {
      "path": "/referral",
      "component": "pages/public/page.tsx",
      "titleKey": "pageTitles.referral",
      "descriptionKey": "pageDescriptions.referral"
    }
  ],
  "adminRoutes": [
    {
      "path": "/referral",
      "component": "pages/admin/page.tsx",
      "permission": "referral.manage"
    }
  ],
  "api": [
    {
      "path": "/referral",
      "handler": "api/route.ts",
      "description": "Get referral info for the current user and claim/create a referral.",
      "openTo": "member"
    },
    {
      "path": "/referral/stats",
      "handler": "api/stats/route.ts",
      "description": "Get referral statistics and optionally track a referral event.",
      "permission": "referral.manage"
    }
  ],
  "menu": [
    {
      "label": "Referrals",
      "path": "/referral",
      "icon": "UserPlus",
      "group": "commerce",
      "permission": "referral.manage"
    }
  ],
  "profileTabs": [
    {
      "id": "referrals",
      "label": "Referrals",
      "component": "components/ReferralTab.tsx",
      "order": 40,
      "labelKey": "referral.profileTab"
    }
  ],
  "hooksEmitted": [
    {
      "hook": "referral.referral.used",
      "type": "action"
    },
    {
      "hook": "credit.change",
      "type": "filter"
    }
  ],
