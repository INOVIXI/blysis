    {
      "type": "suggestions.suggestion.created",
      "prefix": "Suggested: ",
      "key": "suggestionCreated"
    },
    {
      "type": "suggestions.comment.created",
      "prefix": "Commented on: ",
      "key": "suggestionCommented"
    }
  ]
