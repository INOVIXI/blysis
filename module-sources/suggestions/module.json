{
  "id": "suggestions",
  "name": "Suggestions",
  "description": "Community feature suggestions with voting",
  "version": "1.6.3",
  "coreVersion": "^3.0.0",
  "category": "community",
  "author": "Blysis",
  "icon": "MessageSquare",
  "permissions": [
    "suggestions.manage"
  ],
  "routes": [
    {
      "path": "/suggestions",
      "component": "pages/public/page.tsx",
      "titleKey": "pageTitles.suggestions",
      "descriptionKey": "pageDescriptions.suggestions"
    },
    {
      "path": "/suggestions/[id]",
      "component": "pages/public/[id]/page.tsx",
      "titleKey": "pageTitles.suggestions",
      "descriptionKey": "pageDescriptions.suggestions",
      "resolver": "lib/suggestion-exists.ts"
    }
  ],
  "adminRoutes": [
    {
      "path": "/suggestions",
      "component": "pages/admin/page.tsx"
    }
  ],
  "menu": [
    {
      "label": "Suggestions",
      "path": "/suggestions",
      "icon": "MessageSquare",
      "group": "community"
    }
  ],
  "api": [
    {
      "path": "/suggestions",
      "handler": "api/route.ts",
      "description": "List suggestions and create a new suggestion."
    },
    {
      "path": "/suggestions/[id]/vote",
      "handler": "api/[id]/vote/route.ts",
      "description": "Vote on a suggestion."
    },
    {
      "path": "/suggestions/[id]",
      "handler": "api/[id]/route.ts",
      "description": "Update or delete a single suggestion (admin)."
    },
    {
      "path": "/suggestions/[id]/comments",
      "handler": "api/[id]/comments/route.ts",
      "description": "List the discussion under a suggestion, or add to it."
    },
    {
      "path": "/suggestions/comments/[id]",
      "handler": "api/comments/[id]/route.ts",
      "description": "Delete a comment (its author, or a moderator)."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "suggestions.suggestion.created",
      "type": "action"
    },
    {
      "hook": "suggestions.suggestion.deleted",
      "type": "action"
    },
    {
      "hook": "suggestions.suggestion.statusChanged",
      "type": "action"
    },
    {
      "hook": "suggestions.suggestion.unvoted",
      "type": "action"
    },
    {
      "hook": "suggestions.suggestion.updated",
      "type": "action"
    },
    {
      "hook": "suggestions.suggestion.voted",
      "type": "action"
    }
  ],
