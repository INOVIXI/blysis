  "userDataExport": [
    {
      "model": "suggestion",
      "key": "suggestions.suggestions",
      "column": "authorId",
      "erasure": "retain"
    },
    {
      "model": "suggestionVote",
      "key": "suggestions.votes",
      "column": "userId",
      "erasure": "purge"
    },
    {
      "model": "suggestionComment",
      "key": "suggestions.comments",
      "column": "authorId",
      "erasure": "retain"
    }
  ],
  "moderationProviders": [
    {
      "id": "suggestion",
      "label": "Suggestions",
      "labelKey": "moderation_suggestion",
      "settingKey": "suggestions",
      "settingLabelKey": "moderationSettings_suggestions",
      "settingDescKey": "moderationSettings_suggestionsDesc",
      "handler": "moderation/provider.ts"
    },
    {
      "id": "suggestion-comment",
      "label": "Suggestion comments",
      "labelKey": "moderation_suggestionComment",
      "settingKey": "suggestion_comments",
      "settingLabelKey": "moderationSettings_suggestionComments",
      "settingDescKey": "moderationSettings_suggestionCommentsDesc",
      "handler": "moderation/comments.ts"
    }
  ],
  "navLinks": [
    {
      "label": "Suggestions",
      "labelKey": "suggestions",
      "href": "/suggestions",
      "icon": "Lightbulb",
      "position": 70
