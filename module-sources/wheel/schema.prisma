// Wheel Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// @@user-relations-start
//   wheelSpins       WheelSpin[]        @relation("WheelSpins")
// @@user-relations-end

// ==================== WHEEL OF FORTUNE ====================

/**
 * One wheel. A site may run several: a free daily one for everybody, a weekly
 * one for the people who bought a rank, one that costs credits.
 *
 * The cooldown, the price and who may reach it belong here rather than to the
 * module, because they are what makes two wheels two wheels.
 */
model Wheel {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  /** none | daily | weekly | monthly | custom - see lib/wheels.ts */
  cooldown      String   @default("daily")
  /** Hours between turns when `cooldown` is custom. */
  cooldownHours Int      @default(24)
  /** What one turn costs in credits. Zero is free. */
  cost          Int      @default(0)
  /** Role ids that may turn it. Empty means anyone with an account. */
  roleIds       String[] @default([])
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prizes WheelPrize[]
  spins  WheelSpin[]

  @@index([isActive, order])
}

model WheelPrize {
  id          String  @id @default(cuid())
  wheelId     String?
  wheel       Wheel?  @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  name        String
  type        String
  /**
   * For a prize of kind `product`: what to hand over, as whoever owns it
   * named itself through `grantable.options`.
   *
   * Opaque here on purpose. This module gives prizes and has no vocabulary
   * for what a prize is made of; it knew about credits and discounts and
   * nothing else, so a prize of any other kind was drawn, written down,
   * announced in the public feed and handed over as thin air.
   */
  productId   String?
  value       Int     @default(0)
  color       String  @default("#3b82f6")
  probability Int     @default(10)
  isActive    Boolean @default(true)
  order       Int     @default(0)

  @@index([wheelId])
}

model WheelSpin {
  id        String   @id @default(cuid())
  wheelId   String?
  wheel     Wheel?   @relation(fields: [wheelId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation("WheelSpins", fields: [userId], references: [id], onDelete: Cascade)
  prizeId   String?
  prizeName String
  prizeValue Int     @default(0)
  createdAt DateTime @default(now())

  // Read as "when did this person last turn this wheel", which is the
  // question every cooldown asks.
  // A lone @@index([userId]) would be dead weight beside it: an index that
  // leads with the same column already answers those reads.
  @@index([userId, wheelId, createdAt])
  // The foreign key's own index: retiring a wheel has to find its turns
  // without reading the table.
  @@index([wheelId])
}
