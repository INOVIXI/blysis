{
  "id": "wheel",
  "name": "Wheel of Fortune",
  "description": "Spin-to-win game with configurable prizes and cooldowns",
  "version": "1.8.2",
  "coreVersion": "^3.0.0",
  "category": "commerce",
  "author": "Blysis",
  "icon": "Dices",
  "permissions": [
    "wheel.manage"
  ],
  "menu": [
    {
      "label": "Wheels",
      "path": "/wheel-wheels",
      "icon": "Dices",
      "group": "commerce"
    },
    {
      "label": "Wheel Prizes",
      "path": "/wheel-prizes",
      "icon": "Dices",
      "group": "commerce"
    }
  ],
  "routes": [
    {
      "path": "/wheel",
      "component": "pages/public/page.tsx",
      "titleKey": "pageTitles.wheel",
      "descriptionKey": "pageDescriptions.wheel"
    }
  ],
  "adminRoutes": [
    {
      "path": "/wheel-wheels",
      "component": "pages/admin/wheels/page.tsx"
    },
    {
      "path": "/wheel-prizes",
      "component": "pages/admin/prizes/page.tsx"
    }
  ],
  "api": [
    {
      "path": "/wheel/prizes",
      "handler": "api/prizes/route.ts",
      "description": "List wheel prizes and create new ones (admin)."
    },
    {
      "path": "/wheel/prizes/[id]",
      "handler": "api/prizes/[id]/route.ts",
      "description": "Update or delete a single wheel prize (admin)."
    },
    {
      "path": "/wheel/spin",
      "handler": "api/spin/route.ts",
      "description": "Spin the prize wheel and award a prize to the current user.",
      "rateLimit": {
        "maxRequests": 30,
        "windowMs": 60000
      }
    },
    {
      "path": "/wheel/wheels",
      "handler": "api/wheels/route.ts",
      "description": "List the wheels a visitor can see, with their prizes."
    },
    {
      "path": "/wheel/admin/wheels",
      "handler": "api/admin/wheels/route.ts",
      "description": "List every wheel including the switched-off ones, or create one (admin)."
    },
    {
      "path": "/wheel/admin/wheels/[id]",
      "handler": "api/admin/wheels/[id]/route.ts",
      "description": "Update or delete a single wheel (admin)."
    }
  ],
  "settings": [],
  "dependencies": [
    "credits",
    "store"
  ],
  "hooksEmitted": [
    {
      "hook": "wheel.prize.won",
      "type": "action"
    },
    {
      "hook": "wheel.spin.completed",
      "type": "action"
    },
    {
      "hook": "credit.change",
      "type": "filter"
    },
    {
      "hook": "coupon.issue",
      "type": "filter"
    }
  ],
