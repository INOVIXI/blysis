{
  "id": "changelog",
  "name": "Changelog",
  "description": "Release notes and update history",
  "version": "1.5.2",
  "coreVersion": "^3.0.0",
  "category": "community",
  "author": "Blysis",
  "icon": "History",
  "permissions": [
    "changelog.manage"
  ],
  "menu": [
    {
      "label": "Changelog",
      "path": "/changelog",
      "icon": "History",
      "group": "content",
      "section": "publishing",
      "permission": "changelog.manage"
    }
  ],
  "routes": [
    {
      "path": "/changelog",
      "component": "pages/public/page.tsx",
      "titleKey": "pageTitles.changelog",
      "descriptionKey": "pageDescriptions.changelog"
    },
    {
      "path": "/changelog/[...slug]",
      "component": "pages/public/entry/[number]/page.tsx",
      "resolver": "lib/entry-exists.ts",
      "titleKey": "pageTitles.changelog",
      "descriptionKey": "pageDescriptions.changelog",
      "ogType": "article"
    }
  ],
  "adminRoutes": [
    {
      "path": "/changelog",
      "component": "pages/admin/page.tsx",
      "permission": "changelog.manage"
    }
  ],
  "api": [
    {
      "path": "/changelog",
      "handler": "api/route.ts",
      "description": "List changelog entries and create new ones (admin).",
      "permission": "changelog.manage"
    },
    {
      "path": "/changelog/[id]",
      "handler": "api/[id]/route.ts",
      "description": "Update or delete a single changelog entry (admin).",
      "permission": "changelog.manage"
    },
    {
      "path": "/changelog/entry/[number]",
      "handler": "api/entry/[number]/route.ts",
      "method": "GET",
      "description": "One published release entry in full, for its own page."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "changelog.entry.deleted",
      "type": "action"
    },
    {
      "hook": "changelog.entry.published",
      "type": "action"
    },
    {
      "hook": "changelog.entry.updated",
      "type": "action"
    }
  ],
