// Changelog Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// ==================== CHANGELOG ====================

/// A kind of release, as this community names them.
///
/// Six were written into the module as an array - feature, improvement, fix,
/// security, removed, breaking - with a colour and a translation key each.
/// Six good words, and six is not every community's six: nobody could add
/// "Known issue" or "Map reset", and nobody could take one away.
///
/// A kind an operator adds carries `name`, the word they typed, and nothing
/// else. The six this module ships carry `nameKey` instead so they stay
/// translated - the same split `PunishmentScope` makes between a name a
/// reader sees and a key nothing draws.
model ChangelogType {
  id        String   @id @default(cuid())
  /// What an entry's `type` column holds. Stable; the label may change.
  key       String   @unique
  /// The word a reader sees, for a kind somebody here invented.
  name      String?
  /// The module's own key, for the six it ships. Wins over `name`.
  nameKey   String?
  /// Which badge it wears: neutral, success, warning, danger or info.
  tone      String   @default("neutral")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, order])
}

model ChangelogEntry {
  id        String   @id @default(cuid())
  /// Stable number in the URL, so renaming a release does not break a link
  /// somebody has already shared. The slug beside it is cosmetic, which is
  /// the same shape an article uses.
  number    Int      @unique @default(autoincrement())
  slug      String   @default("")
  version   String
  title     String
  /// The summary on the timeline. Kept short on purpose: it is read in a list.
  content   String   @db.Text
  /// The long form, for a release that needs more than a line - what was
  /// tried, a screenshot, the steps to take. Absent for most entries, and a
  /// release without one has no page of its own and no link to follow.
  details     String? @db.Text
  /// Drawn at the top of that page and nowhere else. The timeline is a list of
  /// releases and a picture per row would bury the one thing it is for.
  coverImage  String?
  type      String   @default("update")
  color     String?  @default("#3b82f6")
  isActive  Boolean  @default(true)
  publishAt DateTime?
  createdAt DateTime @default(now())

  @@index([slug])
}
