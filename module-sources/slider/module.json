{
  "id": "slider",
  "name": "Slider",
  "description": "Homepage image carousel and banners",
  "version": "1.2.2",
  "coreVersion": "^4.0.0",
  "category": "content",
  "author": "Blysis",
  "icon": "Image",
  "permissions": [
    "slider.manage"
  ],
  "menu": [
    {
      "label": "Slider",
      "path": "/slider",
      "icon": "Image",
      "group": "design",
      "section": "layout",
      "permission": "slider.manage"
    }
  ],
  "adminRoutes": [
    {
      "path": "/slider",
      "component": "pages/admin/page.tsx",
      "permission": "slider.manage"
    }
  ],
  "api": [
    {
      "path": "/slider",
      "handler": "api/route.ts",
      "description": "List homepage slider slides and create new ones (admin).",
      "permission": "slider.manage"
    },
    {
      "path": "/slider/[id]",
      "handler": "api/[id]/route.ts",
      "description": "Update or delete a slide (admin).",
      "permission": "slider.manage"
    }
  ],
  "widgets": [
    {
      "id": "SliderWidget",
      "label": "Homepage Slider",
      "labelKey": "widget_homepageSlider",
      "component": "widgets/slider-widget",
      "defaultOrder": -10,
      "defaultVisible": true
    }
  ],
