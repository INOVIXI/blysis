{
  "id": "roblox-auth",
  "name": "Roblox Login",
  "description": "Allow users to sign in with their Roblox account",
  "version": "1.2.2",
  "coreVersion": "^3.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "Boxes",
  "adminRoutes": [
    {
      "path": "/settings/roblox-auth",
      "component": "pages/admin/settings/roblox-auth/page.tsx",
      "permission": "roblox-auth.manage"
    }
  ],
  "settingsCards": [
    {
      "title": "Roblox OAuth",
      "description": "Roblox application credentials.",
      "href": "/settings/roblox-auth",
      "icon": "Boxes",
      "color": "text-foreground"
    }
  ],
  "authProviders": [
    {
      "id": "roblox",
      "envIdVar": "AUTH_ROBLOX_ID",
      "envSecretVar": "AUTH_ROBLOX_SECRET"
    }
  ],
  "oauthButtons": [
    {
      "id": "roblox-login",
      "provider": "roblox",
      "label": "Roblox",
      "color": "currentColor",
      "svgIcon": "M18.926 23.998 0 18.892 5.075.002 24 5.108ZM15.348 10.09l-5.282-1.453-1.414 5.273 5.282 1.453z"
    }
  ],
