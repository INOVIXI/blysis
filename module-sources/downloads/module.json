{
  "id": "downloads",
  "name": "Downloads",
  "description": "A file library: releases, guides and anything else worth handing out",
  "version": "1.5.2",
  "coreVersion": "^4.0.0",
  "category": "content",
  "author": "Blysis",
  "icon": "Download",
  "permissions": [
    {
      "name": "downloads.manage",
      "labelKey": "downloads.perm_manage"
    }
  ],
  "menu": [
    {
      "label": "Downloads",
      "path": "/downloads",
      "icon": "Download",
      "group": "content",
      "section": "publishing",
      "permission": "downloads.manage"
    }
  ],
  "routes": [
    {
      "path": "/downloads",
      "component": "pages/public/page.tsx",
      "titleKey": "pageTitles.downloads",
      "descriptionKey": "pageDescriptions.downloads"
    },
    {
      "path": "/downloads/[...slug]",
      "component": "pages/public/guide/[number]/page.tsx",
      "titleKey": "pageTitles.downloads",
      "descriptionKey": "pageDescriptions.downloads",
      "resolver": "lib/download-exists.ts"
    }
  ],
  "adminRoutes": [
    {
      "path": "/downloads",
      "component": "pages/admin/page.tsx",
      "permission": "downloads.manage"
    }
  ],
  "api": [
    {
      "path": "/downloads",
      "handler": "api/route.ts",
      "description": "List downloadable files and create new ones (admin).",
      "permission": "downloads.manage"
    },
    {
      "path": "/downloads/[id]",
      "handler": "api/[id]/route.ts",
      "description": "Get, update, or delete a single download entry.",
      "permission": "downloads.manage"
    },
    {
      "path": "/downloads/guide/[number]",
      "handler": "api/guide/[number]/route.ts",
      "method": "GET",
      "description": "One active download with its guide, for its own page."
    }
  ],
  "hooksEmitted": [
    {
      "hook": "downloads.file.downloaded",
      "type": "action"
    }
  ],
