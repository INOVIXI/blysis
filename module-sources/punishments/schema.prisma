// Punishments Module - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// The other side of `Punishment.userId`. Core's `User` may not name a
// module's model, so the merge collects the field from here.
// @@user-relations-start
//   punishments      Punishment[]       @relation("MemberPunishments")
// @@user-relations-end

// ==================== PUNISHMENTS ====================

/// Where a rule applies, as the operator divides it up.
///
/// The record had one idea of "where" - which module reported it - and that
/// answers a different question. One site runs Survival and Skyblock off the
/// same server and wants them apart; another runs Minecraft and CS:GO; and
/// nearly everyone wants a ban handed down in a game kept apart from what this
/// website does about it.
///
/// `restrictsSite` is that last part, per scope, because it is the operator's
/// call and not ours: a Skyblock ban should not have to close somebody's forum
/// account, and a Survival ban might be exactly that.
model PunishmentScope {
  id            String   @id @default(cuid())
  /// What an operator typed. This is the only form a reader ever sees.
  name          String
  /// What a reporting module calls this place - LiteBans' `server_scope`, for
  /// instance. Machine-facing; never drawn.
  matchKey      String?  @unique
  /// Whether a punishment recorded here also restricts this website.
  restrictsSite Boolean  @default(false)
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  punishments   Punishment[]

  @@index([isActive, order])
}

model Punishment {
  id         String    @id @default(cuid())
  /**
   * The member this was issued against, when anybody knows which member that
   * is. A punishment written on this site always has one; one that arrived
   * from a game server has one only if the account was linked and proved.
   */
  userId     String?
  user       User?     @relation("MemberPunishments", fields: [userId], references: [id], onDelete: SetNull)
  /** The in-game name, for a punishment that came from a game server. */
  playerName String
  playerUuid String?
  /**
   * Who recorded it. "site" is an administrator here; anything else is the id
   * of the module that brought it in, and `externalRef` is that system's own
   * identifier, so a webhook delivered twice updates one row.
   */
  source     String    @default("site")
  externalRef String?
  type       String
  reason     String?
  duration   String?
  active     Boolean   @default(true)
  /**
   * Who lifted it, and the reason they gave. Empty on a punishment nobody has
   * lifted, and empty on one lifted by a system that does not say - a record
   * that reports only that a ban stopped reads like it expired, which is the
   * opposite of what an appeal upheld means to the member it was against.
   */
  liftedBy   String?
  liftReason String?
  punishedBy String?
  /// The place this happened, once somebody has named that place.
  scopeId    String?
  scope      PunishmentScope? @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  /**
   * What the reporter called the place, kept whether or not a scope claims it.
   * A key nothing matches is not turned into a scope: it is the other system's
   * word, and inventing a scope out of it would put `srv-2` on a public list.
   * Kept so a scope made later can claim the rows that were waiting.
   */
  scopeKey   String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@unique([source, externalRef])
  @@index([userId])
  @@index([playerName])
  @@index([type])
  @@index([active])
  @@index([scopeId])
  @@index([scopeKey])
}
