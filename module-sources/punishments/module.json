{
  "id": "punishments",
  "name": "Punishments",
  "description": "Bans, mutes and warnings against members, issued here or reported by a module that watches somewhere else",
  "version": "1.7.2",
  "coreVersion": "^3.0.0",
  "category": "management",
  "author": "Blysis",
  "icon": "Shield",
  "permissions": [
    "punishments.manage"
  ],
  "routes": [
    {
      "path": "/punishments",
      "component": "pages/public/page.tsx",
      "titleKey": "pageTitles.punishments",
      "descriptionKey": "pageDescriptions.punishments"
    }
  ],
  "adminRoutes": [
    {
      "path": "/punishments",
      "component": "pages/admin/page.tsx",
      "permission": "punishments.manage"
    }
  ],
  "menu": [
    {
      "label": "Punishments",
      "path": "/punishments",
      "icon": "Shield",
      "group": "gaming",
      "permission": "punishments.manage"
    }
  ],
  "navLinks": [
    {
      "label": "Punishments",
      "labelKey": "punishments",
      "href": "/punishments",
      "icon": "Shield",
      "position": 80
    }
  ],
  "api": [
    {
      "path": "/punishments",
      "handler": "api/route.ts",
      "description": "List punishments and create new ones (admin).",
      "permission": "punishments.manage"
    },
    {
      "path": "/punishments/[id]",
      "handler": "api/[id]/route.ts",
      "description": "Update or delete a single punishment (admin).",
      "permission": "punishments.manage"
    }
  ],
  "hooksEmitted": [
    {
      "hook": "punishments.punishment.issued",
      "type": "action"
    },
    {
      "hook": "punishments.punishment.revoked",
      "type": "action"
    }
  ],
