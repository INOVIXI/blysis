{
  "id": "trophies",
  "name": "Trophies",
  "description": "Achievement badges with rule-based auto-award engine",
  "version": "1.7.2",
  "coreVersion": "^5.0.0",
  "category": "community",
  "author": "Blysis",
  "icon": "Trophy",
  "permissions": [
    {
      "name": "trophies.manage",
      "labelKey": "trophies.perm_manage"
    }
  ],
  "menu": [
    {
      "label": "Trophies",
      "path": "/trophies",
      "icon": "Trophy",
      "group": "gaming",
      "permission": "trophies.manage"
    }
  ],
  "routes": [
    {
      "path": "/trophies",
      "component": "pages/public/page.tsx",
      "titleKey": "pageTitles.trophies",
      "descriptionKey": "pageDescriptions.trophies"
    }
  ],
  "adminRoutes": [
    {
      "path": "/trophies",
      "component": "pages/admin/page.tsx",
      "permission": "trophies.manage"
    }
  ],
  "api": [
    {
      "path": "/trophies",
      "handler": "api/route.ts",
      "description": "Public list + admin create.",
      "permission": "trophies.manage"
    },
    {
      "path": "/trophies/[id]",
      "handler": "api/[id]/route.ts",
      "description": "Admin update + delete.",
      "permission": "trophies.manage"
    },
    {
      "path": "/me/trophies",
      "handler": "api/me/route.ts",
      "description": "Earned trophies for the current user.",
      "openTo": "member"
    },
    {
      "path": "/admin/trophies",
      "handler": "api/admin/route.ts",
      "description": "Admin trophy list + create.",
      "permission": "trophies.manage"
    },
    {
      "path": "/admin/trophies/[id]",
      "handler": "api/admin/[id]/route.ts",
      "description": "Admin trophy update + delete.",
      "permission": "trophies.manage"
    },
    {
      "path": "/admin/trophies/reload",
      "handler": "api/admin/reload/route.ts",
      "description": "Re-register trophy hook listeners after a rule change.",
      "permission": "trophies.manage"
    }
  ],
  "navLinks": [
    {
      "label": "Trophies",
      "labelKey": "trophies",
      "href": "/trophies",
      "icon": "Trophy",
      "position": 60
    }
  ],
  "footerLinks": [
    {
      "label": "Trophies",
      "labelKey": "trophies",
      "href": "/trophies",
      "section": "quick"
    }
  ],
  "profileTabs": [
    {
      "id": "trophies",
      "label": "Trophies",
      "component": "components/TrophiesTab",
      "order": 25,
      "labelKey": "trophies.profileTab"
    }
  ],
  "settingsCards": [
    {
      "title": "Trophies",
      "description": "Manage achievement badges and rules",
      "href": "/trophies",
      "icon": "Award",
      "color": "text-amber-500"
    }
  ],
  "hookListeners": [
    {
      "hook": "core.boot",
      "type": "action",
      "handler": "hooks/on-core-boot.ts"
    }
  ],
  "seoRoutes": {
    "handler": "seo/sitemap.ts"
  },
  "userDataExport": [
    {
      "model": "userTrophy",
      "key": "trophies.earned",
      "column": "userId",
      "erasure": "retain"
    }
  ],
