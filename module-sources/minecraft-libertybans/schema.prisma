// Minecraft Punishments (LibertyBans) - Database Models
// These models are merged into prisma/schema.prisma by merge-schemas.ts

// ==================== LIBERTYBANS SYNC ====================

/// How far through LibertyBans' punishment history the last read got.
///
/// LibertyBans numbers every punishment from one sequence whatever its kind,
/// so one place in it is enough, unlike LiteBans, which numbers four tables on
/// their own. The row is still keyed, by `history`, so a second cursor never
/// needs a second table.
///
/// Nothing here is a copy of the punishments themselves. Those are the
/// punishments module's, written through `punishment.record`, and this holds
/// only enough to know what has already been asked for.
model LibertyBansSync {
  /// Which cursor this is. `history` is the only one.
  kind     String   @id
  /// The highest punishment id read. Zero before the first run.
  lastId   BigInt   @default(0)
  syncedAt DateTime @default(now())
}
