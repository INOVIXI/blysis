{
  "id": "webhook-logs",
  "name": "Webhook Logs",
  "description": "View and manage webhook delivery logs",
  "version": "1.4.0",
  "coreVersion": "^5.0.0",
  "category": "integration",
  "author": "Blysis",
  "icon": "Webhook",
  "permissions": [
    {
      "name": "admin.webhooks",
      "labelKey": "webhookLogs.perm_webhooks"
    }
  ],
  "menu": [
    {
      "label": "Webhook Logs",
      "path": "/webhook-logs",
      "icon": "Webhook",
      "group": "system",
      "section": "history",
      "permission": "admin.webhooks"
    }
  ],
  "adminRoutes": [
    {
      "path": "/webhook-logs",
      "component": "pages/admin/page.tsx",
      "permission": "admin.webhooks"
    }
  ],
  "api": [
    {
      "path": "/webhook-logs",
      "handler": "api/route.ts",
      "description": "List webhook delivery logs (admin).",
      "permission": "admin.webhooks"
    }
  ],
  "cronJobs": [
    {
      "id": "webhook-logs-cleanup",
      "schedule": "every-day",
      "handler": "cron/cleanup.ts"
    }
  ],
